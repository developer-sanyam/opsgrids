# Secrets — never commit a real .env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node
node_modules/
dist/
# The storefront's second Vite output — the anonymous buyer bundle (ADR-0012 §2). `dist/` above
# does not match it, and `make edge-web` builds it on the way to the edge VM.
dist-buyer/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local data
*.sqlite3
/tmp/

# Dev signing keys — generated by `make devkeys`, never committed
tools/dev-bootstrap/keys/

# Local agent tooling — kept on disk, not shared. The one exception is the project
# permission policy, .claude/settings.json, which every session should get.
.claude/*
!.claude/settings.json
edge_selfserve_tenant.json

# Private keys and certificates — never committed (server ssh keys, TLS keys)
*.pem
*.key
