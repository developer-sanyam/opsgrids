# Copy to .env for local development. NEVER commit a real .env.
# In staging and production these come from the platform's secret manager.
#
# Host ports are deliberately offset from the legacy HRMS stack so both can run
# side by side on one machine during the migration.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- datastores ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://opsgrids:opsgrids@localhost:5434/opsgrids
REDIS_URL=redis://localhost:6380/0
RABBITMQ_URL=amqp://opsgrids:opsgrids@localhost:5673/

# --- auth ---------------------------------------------------------------------
# Only auth-service holds the private key. Everything else verifies via JWKS.
# Generate a dev keypair with:  make devkeys
JWT_PRIVATE_KEY_PATH=./tools/dev-bootstrap/keys/dev-ed25519.pem
JWT_KID=dev-1
JWKS_URL=http://localhost:8110/.well-known/jwks.json
JWT_ISSUER=https://auth.opsgrids.local
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Signed header proving a request came from a gateway or a sibling service.
INTERNAL_SERVICE_TOKEN=dev-only-internal-token-padded-to-32-bytes-minimum

# --- PII encryption -----------------------------------------------------------
# Rotating: put the new key in PII_ENCRYPTION_KEY, the old one in PII_DECRYPT_KEYS.
PII_ENCRYPTION_KEY=dev-only-pii-key-change-me
PII_DECRYPT_KEYS=

# --- object storage -----------------------------------------------------------
# document-service's public asset store (ADR-0009). These are the local MinIO values that
# `make infra` brings up, and they are the *only* place in this block a value belongs:
# nothing here is a secret anywhere, and production sets every one of them from the platform's
# secret manager or leaves it unset on purpose.
#
# In production S3_ENDPOINT_URL is UNSET (boto3 derives the AWS endpoint from the region), and
# S3_ACCESS_KEY / S3_SECRET_KEY are UNSET so boto3 falls back to its default credential chain —
# instance profile or IRSA. The settings tolerate their absence deliberately: requiring them
# would mean a long-lived static IAM key in production by construction.
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=opsgrids
S3_SECRET_KEY=opsgrids-secret
S3_REGION=us-east-1
# Public-read in its entirety, created with an anonymous download policy by the `minio-bootstrap`
# one-shot in tools/dev-bootstrap/compose.yml. Nothing that is not intended to be world-readable
# is ever written to it. The private bucket is named in ADR-0009 §2 and is not built.
S3_PUBLIC_BUCKET=opsgrids-public
# MinIO serves path-style (host/bucket/key) unless wildcard DNS is configured; AWS prefers
# virtual-hosted style, so this is `false` in production.
S3_FORCE_PATH_STYLE=true
# What a stored `/a/{org}/{asset}` reference resolves against: the bucket origin in dev, the CDN
# origin in production. Changing it moves every image with no data migration, which is the whole
# payoff of storing a root-relative path rather than an absolute URL.
PUBLIC_ASSET_BASE_URL=http://localhost:9100/opsgrids-public

# --- storefront ---------------------------------------------------------------
# The storefront service's two database roles (ADR-0010 §16). **Neither is set here, and that
# is deliberate** — both are pinned as defaults in `services/storefront/app/config.py`, the
# same way product-service pins `opsgrids_product_directory`:
#
#   opsgrids_storefront            NOBYPASSRLS, DML on the `storefront` schema only.
#   opsgrids_storefront_directory  BYPASSRLS but SELECT-only, on `storefront.storefronts` and
#                                  nothing else. The anonymous serviceability check resolves a
#                                  store slug to an organization before any tenant can be bound;
#                                  on the application role that lookup matches zero rows under
#                                  row-level security and **every buyer is told the store does
#                                  not deliver to them** — HTTP 200, no error, no log. The
#                                  service asserts the role at startup and refuses to boot
#                                  without it, which is the only thing that makes that loud.
#
# ADR-0010 §16 names the variable `STOREFRONT_DB_DIRECTORY_ROLE`. **Do not add it.** It would do
# nothing: `ServiceSettings` sets no `env_prefix`, so the name pydantic reads is the unprefixed
# `DB_DIRECTORY_ROLE` — and this one file is read by every service, so setting it here would
# silently rebind *product-service's* directory reader to storefront's role. Per-service roles
# belong in per-service defaults; in production each service is handed its own DSN and leaves
# these unset entirely.
#
# How long a resolved store slug is cached in Redis. The consequence is a merchant-visible one:
# a newly published store can 404 for this long, and the publish UI says so.
STORE_SLUG_CACHE_SECONDS=300

# --- mail ---------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USE_TLS=false
MAIL_FROM=platform@opsgrids.example

# --- platform -----------------------------------------------------------------
APP_BASE_URL=http://localhost:5273
CORS_ORIGINS=http://localhost:5273

# --- service-to-service ---------------------------------------------------------
# Where employee-service answers its internal reads. Used by approval-service's hierarchy
# backfill (ADR-0006 §2.1) and by `tools/reconcile_membership_links.py` (ADR-0008 §8).
# Not a secret, and not on any request path — both callers are one-shot commands.
EMPLOYEE_SERVICE_URL=http://localhost:8120
