{
  "name": "@opsgrids/ui",
  "version": "0.1.0",
  "private": true,
  "description": "The OpsGrids design system — the Console stylesheet and the components every app imports.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./icons": "./src/icons.tsx",
    "./test-media": "./src/test-media.ts",
    "./styles.css": "./src/styles/console.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --quiet --output-dir storybook-static"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@opsgrids/config": "workspace:*",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.17.0",
    "jsdom": "25.0.1",
    "react": "^19.0.0",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.1.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0"
  }
}
