{
  "name": "@opsgrids/ui",
  "version": "0.1.0",
  "private": true,
  "description": "The OpsGrids design system — the Console stylesheet and the components every app imports.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
