    "@testing-library/user-event": "14.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "25.0.1",
    "react": "^19.0.0",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.1.0",
    "typescript": "^5.7.0",
