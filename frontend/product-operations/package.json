{
  "name": "@opsgrids/product-operations",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Operations product app — procurement, inventory and the paperwork between them.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 4380 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4380 --strictPort",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opsgrids/client": "workspace:*",
    "@opsgrids/ui": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@vis.gl/react-google-maps": "1.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@opsgrids/config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/google.maps": "3.66.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "exceljs": "4.4.0",
    "jsdom": "25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
