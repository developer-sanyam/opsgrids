{
  "name": "@opsgrids/product-support",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Support product app — one queue for customers and staff, with SLAs that mean something.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --port 4430 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4430 --strictPort",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opsgrids/client": "workspace:*",
    "@opsgrids/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@opsgrids/config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "jsdom": "25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
