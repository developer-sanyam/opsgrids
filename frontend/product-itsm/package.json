{
  "name": "@atmora/product-itsm",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone ITSM product app — incidents, service requests and the asset CMDB.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --port 4350 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4340 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@atmora/config": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
