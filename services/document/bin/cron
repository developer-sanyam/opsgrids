#!/usr/bin/env bash
set -euo pipefail
# The purge sweep (ADR-0009 §8, and its 2026-09-23 addendum's §9 orphan pass) — its own process,
# a distinct pool from both the API and the outbox relay, because a poll loop must not share a
# pool with request traffic. This previously pointed at `app.relay`, the untouched scaffold
# default: the relay drains an outbox that stays empty by design (ADR-0009 §7 publishes no
# event), reports itself healthy, and no soft-deleted asset's object was ever actually removed.
exec python -m app.cron
