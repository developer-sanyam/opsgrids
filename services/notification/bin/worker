#!/usr/bin/env bash
set -euo pipefail
# app.worker runs the two event consumers and the campaign send driver together
# (ADR-0013's memory-budget erratum, 2026-09-23 — see app/worker.py's own docstring for why).
# `python -m app.consumers`, `python -m app.dispatcher` and `python -m app.cron` are all still
# independently runnable.
exec python -m app.worker
