{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/storefront.enquiry.status_changed/v1",
  "title": "storefront.enquiry.status_changed",
  "description": "A merchant moved an enquiry through its state machine (`domain.assert_enquiry_transition`). No content changes: apart from `status`, an enquiry is append-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_id", "enquiry_id", "from", "to"],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "enquiry_id": { "type": "string", "format": "uuid" },
    "from": { "enum": ["new", "contacted", "won", "lost"] },
    "to": { "enum": ["new", "contacted", "won", "lost"] }
  }
}
