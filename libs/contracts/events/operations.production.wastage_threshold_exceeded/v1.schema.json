{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.production.wastage_threshold_exceeded/v1",
  "title": "operations.production.wastage_threshold_exceeded",
  "description": "Recorded wastage of a material crossed its threshold (a configured wastage threshold, else the BOM line's scrap allowance). Raised once, on the write that crosses it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "production_order_id",
    "number",
    "material_id",
    "item_id",
    "wastage_type",
    "wasted",
    "allowed",
    "threshold_percent"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "production_order_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string"
    },
    "material_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "wastage_type": {
      "type": "string",
      "enum": [
        "CUTTING",
        "DEFECT",
        "SPILLAGE",
        "DAMAGE",
        "PROCESS_LOSS",
        "LEFTOVER",
        "OTHER"
      ]
    },
    "wasted": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,3})?$"
    },
    "allowed": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,3})?$"
    },
    "threshold_percent": {
      "type": "string",
      "pattern": "^\\d{1,3}(\\.\\d{1,2})?$"
    }
  }
}
