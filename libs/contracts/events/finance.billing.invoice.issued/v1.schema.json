{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/finance.billing.invoice.issued/v1",
  "title": "finance.billing.invoice.issued",
  "description": "An invoice or credit note was issued. Once issued, an invoice changes only by moving to `paid`. A correction is a credit note (`document_type` = credit_note, negative totals). `issued_date` and `due_date` are business dates with no timezone. Money is integer minor units of `currency`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "invoice_id",
    "number",
    "document_type",
    "customer_id",
    "status",
    "issued_date",
    "due_date",
    "currency",
    "subtotal_minor",
    "tax_minor",
    "total_minor",
    "supply_type",
    "place_of_supply",
    "requires_einvoice"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "invoice_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "enum": [
        "invoice",
        "credit_note"
      ]
    },
    "customer_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "void"
      ]
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "subtotal_minor": {
      "type": "integer"
    },
    "tax_minor": {
      "type": "integer"
    },
    "total_minor": {
      "type": "integer"
    },
    "supply_type": {
      "type": "string",
      "minLength": 1
    },
    "place_of_supply": {
      "type": [
        "string",
        "null"
      ]
    },
    "requires_einvoice": {
      "type": "boolean"
    }
  }
}
