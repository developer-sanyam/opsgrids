{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.jobwork.receipt.qc_requested/v1",
  "title": "operations.jobwork.receipt.qc_requested",
  "description": "The QC hand-off point for goods returned from a job worker (Inventory plan Phase 6). Emitted when a receipt on an order flagged `qc_required` brings goods back: the good quantity has been parked in QUALITY_HOLD (not AVAILABLE) at `location_id`, and any rejected quantity sits in REJECTED. The quality package consumes this (app.quality.handoff) to open an incoming inspection per good line and, on release, moves stock out of QUALITY_HOLD. The job-work module neither imports nor waits for that module.",
  "$comment": "Consumed by app.consumers.job_work_qc_requested. `source` identifies the originating process so one consumer can serve GRN receipts and job-work returns alike.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "order_id",
    "order_number",
    "supplier_id",
    "receipt_no",
    "source",
    "lines"
  ],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "order_id": { "type": "string", "format": "uuid" },
    "order_number": { "type": "string", "minLength": 1 },
    "supplier_id": { "type": "string", "format": "uuid" },
    "receipt_no": { "type": "string", "minLength": 1 },
    "source": { "const": "job_work" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_id",
          "item_id",
          "sku",
          "uom",
          "received",
          "rejected",
          "shortage",
          "location_id",
          "status"
        ],
        "properties": {
          "material_id": { "type": "string", "format": "uuid" },
          "item_id": { "type": "string", "format": "uuid" },
          "sku": { "type": "string" },
          "uom": { "type": "string" },
          "received": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "rejected": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "shortage": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "location_id": { "type": "string", "format": "uuid" },
          "lot_id": { "type": ["string", "null"], "format": "uuid" },
          "roll_id": { "type": ["string", "null"], "format": "uuid" },
          "status": { "const": "QUALITY_HOLD" }
        }
      }
    }
  }
}
