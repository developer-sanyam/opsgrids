{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/notification.delivery.message.queued/v1",
  "title": "notification.delivery.message.queued",
  "description": "A message was staged for delivery (a fresh send, or a retry when `retry_of_attempt` is present). The recipient address is deliberately not in the payload; read the message row for it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "message_id",
    "channel",
    "category"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "retry_of_attempt": {
      "type": "integer",
      "minimum": 0
    }
  }
}
