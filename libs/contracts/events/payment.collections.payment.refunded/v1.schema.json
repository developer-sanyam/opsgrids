{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/payment.collections.payment.refunded/v1",
  "title": "payment.collections.payment.refunded",
  "description": "A captured tenant collection's standing refund total changed (ADR-0024 §8): a refund was recorded (asked for through operations, or made in the merchant's own provider dashboard and reported by webhook), or a recorded refund's provider outcome changed (e.g. it failed). `refunded_total_minor` is every refund whose current state is not `failed`; `fully_refunded` is `refunded_total_minor >= amount_minor`. `operations` reads `fully_refunded` to reverse — or restore — the order's paid fact. Identifiers and money only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "charge_id",
    "reference_type",
    "reference_id",
    "amount_minor",
    "currency",
    "provider",
    "provider_payment_id",
    "provider_order_id",
    "state",
    "occurred_at",
    "refund_id",
    "provider_refund_id",
    "refund_amount_minor",
    "refund_state",
    "refunded_total_minor",
    "fully_refunded"
  ],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "charge_id": { "type": "string", "format": "uuid" },
    "reference_type": { "type": "string", "enum": ["operations.order"] },
    "reference_id": { "type": "string", "format": "uuid" },
    "amount_minor": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "provider": { "type": "string", "minLength": 1 },
    "provider_payment_id": { "type": ["string", "null"] },
    "provider_order_id": { "type": ["string", "null"] },
    "state": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "refund_id": { "type": "string", "format": "uuid" },
    "provider_refund_id": { "type": ["string", "null"] },
    "refund_amount_minor": { "type": "integer", "minimum": 1 },
    "refund_state": { "type": "string", "enum": ["created", "processed", "failed"] },
    "refunded_total_minor": { "type": "integer", "minimum": 0 },
    "fully_refunded": { "type": "boolean" }
  }
}
