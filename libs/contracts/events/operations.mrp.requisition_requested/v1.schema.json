{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.mrp.requisition_requested/v1",
  "title": "operations.mrp.requisition_requested",
  "description": "A planner asked purchasing to requisition the purchased-item shortages of an MRP run. request_id is stored on each shortage so the requisition made from it can be linked back.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "request_id",
    "run_id",
    "run_number",
    "note",
    "requested_by",
    "lines"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_number": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "requested_by_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The requester's directory (subject) reference, when they have one; carried onto the requisition for OWN scope."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shortage_id",
          "item_id",
          "sku",
          "uom",
          "quantity",
          "need_by"
        ],
        "properties": {
          "shortage_id": {
            "type": "string",
            "format": "uuid"
          },
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "uom": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,3})?$"
          },
          "need_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      }
    }
  }
}
