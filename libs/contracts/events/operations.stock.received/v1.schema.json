{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.stock.received/v1",
  "title": "operations.stock.received",
  "description": "A delivery was posted against a purchase order (a goods receipt). `lines` is one entry per receipt line: stock lines name the item, location, stock status (QUALITY_HOLD when the item tracks quality), lot and the rolls created; a service line (no stocked item) has null item/location/status. `outcome` says how the line stands against its ordered quantity: PARTIAL (more expected), EXACT, SHORT (closed short) or OVER (within the item's tolerance). `move_id` is the ledger `receipt` move, null when no line brought stock in. Quantities are decimal strings in the item's stock unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "goods_receipt_id",
    "number",
    "purchase_order_id",
    "po_number",
    "po_status",
    "supplier_id",
    "received_on",
    "move_id",
    "lines"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "goods_receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "purchase_order_id": {
      "type": "string",
      "format": "uuid"
    },
    "po_number": {
      "type": "string"
    },
    "po_status": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string",
      "format": "uuid"
    },
    "received_on": {
      "type": "string",
      "format": "date"
    },
    "move_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purchase_order_line_id",
          "sku",
          "inventory_item_id",
          "location_id",
          "status",
          "track_quality",
          "lot_id",
          "roll_ids",
          "received_qty",
          "cumulative_qty",
          "ordered_qty",
          "outcome",
          "close_short"
        ],
        "properties": {
          "purchase_order_line_id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "inventory_item_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "location_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "track_quality": {
            "type": "boolean",
            "description": "Whether the item tracked quality when the receipt was posted; the quality hand-off opens inspections from this, not from the item's current flag."
          },
          "lot_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "roll_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "received_qty": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,3})?$"
          },
          "cumulative_qty": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,3})?$"
          },
          "ordered_qty": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,3})?$"
          },
          "outcome": {
            "enum": [
              "PARTIAL",
              "EXACT",
              "SHORT",
              "OVER"
            ]
          },
          "close_short": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
