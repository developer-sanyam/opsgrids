{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.procurement.purchase_order.approved/v1",
  "title": "operations.procurement.purchase_order.approved",
  "description": "A draft purchase order was approved. `spend_applied` says whether its spend was committed to the supplier's running total (only when the currencies match).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "purchase_order_id",
    "number",
    "spend_applied",
    "currency",
    "total_minor"
  ],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "purchase_order_id": { "type": "string", "format": "uuid" },
    "number": { "type": "string", "minLength": 1 },
    "spend_applied": { "type": "boolean" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "total_minor": { "type": "integer", "minimum": 0 }
  }
}
