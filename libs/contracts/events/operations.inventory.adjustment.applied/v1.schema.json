{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.inventory.adjustment.applied/v1",
  "title": "operations.inventory.adjustment.applied",
  "description": "An adjustment reached a final state: APPLIED (stock moved), REJECTED, or FAILED (approved but the stock could not take it). `outcome` is the approval service's return-leg vocabulary (`applied` | `failed`, ADR-0006 \u00a712); `decision` is what was decided (`approved` | `rejected`; `approved` for an adjustment that needed no approval).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "adjustment_id",
    "number",
    "status",
    "outcome",
    "request_type",
    "approval_request_id",
    "inventory_item_id",
    "location_id",
    "quantity_delta",
    "reason_code",
    "move_id",
    "failure_reason",
    "decision"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "adjustment_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "APPLIED",
        "REJECTED",
        "FAILED"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "applied",
        "failed"
      ]
    },
    "request_type": {
      "const": "operations.inventory.adjustment"
    },
    "approval_request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "inventory_item_id": {
      "type": "string",
      "format": "uuid"
    },
    "location_id": {
      "type": "string",
      "format": "uuid"
    },
    "quantity_delta": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,3})?$"
    },
    "reason_code": {
      "type": "string"
    },
    "move_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    }
  }
}
