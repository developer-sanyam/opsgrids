{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/crm.book.company.updated/v1",
  "title": "crm.book.company.updated",
  "description": "A company's fields were patched. `changed` names them. `name`, `status` and `owner_id` are the company's state after the patch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_id", "company_id", "changed", "name", "status", "owner_id"],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "company_id": { "type": "string", "format": "uuid" },
    "changed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["customer", "prospect", "lead", "churned"] },
    "owner_id": { "type": "string", "format": "uuid" }
  }
}
