{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.procurement.purchase_requisition.created/v1",
  "title": "operations.procurement.purchase_requisition.created",
  "description": "A purchase requisition was raised (as a draft).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "requisition_id",
    "number",
    "status",
    "line_count"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "requisition_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "APPROVED",
        "REJECTED",
        "CONVERTED",
        "CANCELLED"
      ]
    },
    "line_count": {
      "type": "integer"
    }
  }
}
