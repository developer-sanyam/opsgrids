{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.procurement.purchase_order.raised/v1",
  "title": "operations.procurement.purchase_order.raised",
  "description": "A purchase order was created, usually as a draft. `raised_by_id` is the column operations' OWN scope compares with the caller's subject reference. `total_minor` is the sum of the PO's line amounts; a PO has no total column of its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "purchase_order_id",
    "number",
    "status",
    "supplier_id",
    "supplier_name",
    "raised_by_id",
    "created_date",
    "expected_date",
    "currency",
    "total_minor"
  ],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "purchase_order_id": { "type": "string", "format": "uuid" },
    "number": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "approved", "received", "closed", "cancelled"] },
    "supplier_id": { "type": "string", "format": "uuid" },
    "supplier_name": { "type": "string" },
    "raised_by_id": { "type": ["string", "null"], "format": "uuid" },
    "created_date": { "type": "string", "format": "date" },
    "expected_date": { "type": "string", "format": "date" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "total_minor": { "type": "integer", "minimum": 0 }
  }
}
