{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/crm.lead.converted/v1",
  "title": "crm.lead.converted",
  "description": "A lead's conversion completed: the company, contact (null when the lead had no email) and deal it produced exist. `converted_at` is the lead row's own conversion timestamp.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "lead_id",
    "company_id",
    "contact_id",
    "deal_id",
    "owner_id",
    "converted_at"
  ],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "lead_id": { "type": "string", "format": "uuid" },
    "company_id": { "type": "string", "format": "uuid" },
    "contact_id": { "type": ["string", "null"], "format": "uuid" },
    "deal_id": { "type": "string", "format": "uuid" },
    "owner_id": { "type": ["string", "null"], "format": "uuid" },
    "converted_at": { "type": "string", "format": "date-time" }
  }
}
