{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.jobwork.issued/v1",
  "title": "operations.jobwork.issued",
  "description": "Material was sent to a job worker (Inventory plan Phase 6): the order moved APPROVED -> ISSUED, the stock moved AVAILABLE -> AT_JOB_WORKER through the ledger kernel, and a delivery challan was cut. Staged in the issuing transaction, published after it commits. Quantities are exact decimal strings of the item's stock unit; money is integer minor units of `currency`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "order_id",
    "order_number",
    "supplier_id",
    "challan_id",
    "challan_number",
    "total_value_minor",
    "currency",
    "lines"
  ],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "order_id": { "type": "string", "format": "uuid" },
    "order_number": { "type": "string", "minLength": 1 },
    "supplier_id": { "type": "string", "format": "uuid" },
    "challan_id": { "type": "string", "format": "uuid" },
    "challan_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "description": "A financial-year series, e.g. DC/26-27/0001 — gapless and immutable once issued."
    },
    "due_date": { "type": ["string", "null"], "format": "date" },
    "total_value_minor": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "item_id", "sku", "quantity", "uom", "location_id"],
        "properties": {
          "material_id": { "type": "string", "format": "uuid" },
          "item_id": { "type": "string", "format": "uuid" },
          "sku": { "type": "string" },
          "quantity": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "uom": { "type": "string" },
          "location_id": { "type": "string", "format": "uuid" },
          "lot_id": { "type": ["string", "null"], "format": "uuid" },
          "roll_id": { "type": ["string", "null"], "format": "uuid" }
        }
      }
    }
  }
}
