{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.quality.released/v1",
  "title": "operations.quality.released",
  "description": "Held stock was released to AVAILABLE (PASSED) or partly released (PARTIAL_PASS). `accepted_milli` is the quantity that became available; for a partial pass the remainder is announced separately as `operations.quality.rejected`. `move_id` is the kernel move that moved the stock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "inspection_id",
    "item_id",
    "location_id",
    "lot_id",
    "roll_id",
    "quantity_milli",
    "status",
    "accepted_milli",
    "move_id"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "inspection_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "location_id": {
      "type": "string",
      "format": "uuid"
    },
    "lot_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "roll_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "quantity_milli": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "PARTIAL_PASS"
      ]
    },
    "accepted_milli": {
      "type": "integer",
      "minimum": 1
    },
    "move_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
