{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.procurement.purchase_requisition.approved/v1",
  "title": "operations.procurement.purchase_requisition.approved",
  "description": "A submitted requisition was approved; `note` is the approver's optional note.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "requisition_id",
    "number",
    "status"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "requisition_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "APPROVED",
        "REJECTED",
        "CONVERTED",
        "CANCELLED"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}
