{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.production.material_shortage/v1",
  "title": "operations.production.material_shortage",
  "description": "A reservation for a production order could not cover every material from available stock. Lists what is still uncovered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "production_order_id",
    "number",
    "shortages"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "production_order_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string"
    },
    "shortages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_id",
          "item_id",
          "sku",
          "required",
          "covered",
          "short"
        ],
        "properties": {
          "material_id": {
            "type": "string",
            "format": "uuid"
          },
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "required": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,3})?$"
          },
          "covered": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,3})?$"
          },
          "short": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,3})?$"
          }
        }
      }
    }
  }
}
