{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/finance.billing.purchase.recorded/v1",
  "title": "finance.billing.purchase.recorded",
  "description": "A supplier's document was recorded in the purchase book. Amounts are positive for every `document_type`; a consumer applies the sign (a credit_note reduces spend). `document_date` is the supplier document's own business date.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "purchase_document_id",
    "number",
    "document_type",
    "document_date",
    "currency",
    "taxable_minor",
    "tax_minor",
    "total_minor"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "purchase_document_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "enum": [
        "invoice",
        "credit_note",
        "debit_note"
      ]
    },
    "document_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "taxable_minor": {
      "type": "integer",
      "minimum": 1
    },
    "tax_minor": {
      "type": "integer",
      "minimum": 0
    },
    "total_minor": {
      "type": "integer",
      "minimum": 1
    }
  }
}
