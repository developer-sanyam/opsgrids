{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/operations.jobwork.received/v1",
  "title": "operations.jobwork.received",
  "description": "Material came back from a job worker, in whole or in part (Inventory plan Phase 6). One event per receipt document (`receipt_no`); each line accounts for some of one material's outstanding quantity as received (good), rejected (unusable) or shortage (declared lost). Staged in the receiving transaction alongside the ledger moves, published after commit. Quantities are exact decimal strings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "order_id",
    "order_number",
    "supplier_id",
    "receipt_no",
    "received_on",
    "fully_received",
    "outstanding",
    "qc_required",
    "lines"
  ],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "order_id": { "type": "string", "format": "uuid" },
    "order_number": { "type": "string", "minLength": 1 },
    "supplier_id": { "type": "string", "format": "uuid" },
    "receipt_no": { "type": "string", "minLength": 1 },
    "received_on": { "type": "string", "format": "date" },
    "fully_received": {
      "type": "boolean",
      "description": "True when this receipt left nothing outstanding at the vendor — the order is now RECEIVED and can be reconciled and closed."
    },
    "outstanding": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,3})?$",
      "description": "Total still at the vendor across every material, after this receipt (milli-unit sum; meaningful as a figure, not in any one unit when materials mix units)."
    },
    "qc_required": { "type": "boolean" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_id",
          "item_id",
          "sku",
          "uom",
          "received",
          "rejected",
          "shortage",
          "location_id"
        ],
        "properties": {
          "material_id": { "type": "string", "format": "uuid" },
          "item_id": { "type": "string", "format": "uuid" },
          "sku": { "type": "string" },
          "uom": { "type": "string" },
          "received": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "rejected": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "shortage": { "type": "string", "pattern": "^\\d+(\\.\\d{1,3})?$" },
          "location_id": { "type": "string", "format": "uuid" },
          "lot_id": { "type": ["string", "null"], "format": "uuid" },
          "roll_id": { "type": ["string", "null"], "format": "uuid" }
        }
      }
    }
  }
}
