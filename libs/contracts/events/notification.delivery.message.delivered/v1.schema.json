{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/notification.delivery.message.delivered/v1",
  "title": "notification.delivery.message.delivered",
  "description": "The provider reported a message delivered. The recipient address is deliberately not in the payload; read the message row for it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "message_id",
    "channel",
    "status",
    "rule_code"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "rule_code": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
