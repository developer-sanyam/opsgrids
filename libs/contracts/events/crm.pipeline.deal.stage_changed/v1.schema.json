{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsgrids://contracts/crm.pipeline.deal.stage_changed/v1",
  "title": "crm.pipeline.deal.stage_changed",
  "description": "A deal moved stage under deal's transition rule. `from` and `to` are stage keys and never change meaning; `from_outcome` and `to_outcome` (open, won or lost) are what a consumer tests, never the keys. `to_label` is the target stage's label at the time of the move, for display only. The rest is the deal's state after the move. `closed_at` is set when `to_outcome` is won or lost (a closed deal moves nowhere afterwards) and null otherwise.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "deal_id",
    "from",
    "to",
    "from_outcome",
    "to_outcome",
    "name",
    "value_minor",
    "currency",
    "owner_id",
    "probability",
    "closed_at"
  ],
  "properties": {
    "organization_id": { "type": "string", "format": "uuid" },
    "crm_company_id": { "type": "string", "format": "uuid" },
    "crm_contact_id": { "type": ["string", "null"], "format": "uuid" },
    "deal_id": { "type": "string", "format": "uuid" },
    "from": { "type": "string", "pattern": "^[a-z0-9_]{1,20}$" },
    "to": { "type": "string", "pattern": "^[a-z0-9_]{1,20}$" },
    "from_outcome": { "enum": ["open", "won", "lost"] },
    "to_outcome": { "enum": ["open", "won", "lost"] },
    "to_label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "name": { "type": "string", "minLength": 1 },
    "value_minor": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "owner_id": { "type": "string", "format": "uuid" },
    "probability": { "type": "integer", "minimum": 0, "maximum": 100 },
    "closed_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
