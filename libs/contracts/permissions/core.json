      "code": "ORG_ADMIN",
      "cross_product": false,
      "description": "Manages people and structure, but not billing. The organization's administrator. SLA policy is organization configuration, not billing, so it is in scope for the role defined as people and structure. The image library is organization content rather than billing, so it belongs to the same role.",
      "grants": [
        {
          "code": "core.approval.delegation.write",
          "scope": "ORG"
        },
        {
