{
  "manifest_version": 1,
  "permissions": [
    {
      "action": "write",
      "default_scope": "OWN",
      "description": "Create and revoke delegations: OWN only where the caller is the delegator; ORG for any delegator",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "approval",
      "resource": "delegation"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Edit the SLA policy for a request type",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "approval",
      "resource": "policy"
    },
    {
      "action": "decide",
      "default_scope": "OWN",
      "description": "Decide a pending request: OWN where the routing chain makes the caller eligible; ORG additionally decides unassigned steps",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "approval",
      "resource": "request"
    },
    {
      "action": "read",
      "default_scope": "OWN",
      "description": "See approval requests: OWN reaches requests raised or eligible on, and the caller's own chain; ORG reaches every request and any employee's chain",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "approval",
      "resource": "request"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the credit balance",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "billing",
      "resource": "credit"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See invoices",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "billing",
      "resource": "invoice"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "List the organization's uploaded images and read one image's details. Organization-wide: an asset library has no team or location reading",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "content",
      "resource": "asset"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Upload an image to the organization's library, and remove one from it \u2014 including an immediate takedown of the published object",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "content",
      "resource": "asset"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "Read the audit trail",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "audit"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See claimed and verified domains",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "domain"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Claim, verify and release email domains",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "domain"
    },
    {
      "action": "read",
      "default_scope": "TEAM",
      "description": "See who is in the organization",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "membership"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Invite, deactivate and edit members",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "membership"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See roles and what they grant",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "role"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create roles and change grants",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "role"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the single sign-on setup",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "sso"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Configure the identity provider users sign in through",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "identity",
      "resource": "sso"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See sites",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "org",
      "resource": "location"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create and edit sites",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "org",
      "resource": "location"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the organization's profile",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "org",
      "resource": "organization"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Change name, address, tax identifiers",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "org",
      "resource": "organization"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See departments and teams",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "org",
      "resource": "unit"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create and reorganize departments",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "org",
      "resource": "unit"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See which products are active",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "product",
      "resource": "activation"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Activate and deactivate products",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "product",
