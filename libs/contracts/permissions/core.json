          "code": "core.identity.domain.write",
          "scope": "ORG"
        },
        {
          "code": "core.identity.membership.read",
          "scope": "ORG"
        },
        {
          "code": "core.identity.membership.write",
          "scope": "ORG"
        },
        {
          "code": "core.identity.role.read",
          "scope": "ORG"
