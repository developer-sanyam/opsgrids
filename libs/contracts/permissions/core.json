  "product": "core",
  "role_templates": [
    {
      "code": "ORG_OWNER",
      "cross_product": false,
      "description": "Runs the account: billing, product activation, members and roles. Deliberately separate from a product administrator \u2014 owning the company is not the same job as administering its HR data. Account's template already grants every `core` permission at ORG over its own specs; this is approval's contribution to that union. It is what guarantees every organization ends ADR-0007's reconcile with at least one holder of decide:ORG, so the unassigned queue always has an owner. Document's contribution to that union is the organization's image library.",
      "grants": [
        {
          "code": "core.approval.delegation.write",
          "scope": "ORG"
        },
        {
          "code": "core.approval.policy.write",
          "scope": "ORG"
