    {
      "action": "read",
      "default_scope": "ORG",
      "description": "Browse the marketplace",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "product",
      "resource": "catalogue"
    },
    {
      "action": "read",
      "default_scope": "OWN",
      "description": "See your own profile",
      "is_dangerous": false,
      "max_scope": "OWN",
      "module": "profile",
      "resource": "self"
    },
    {
      "action": "write",
      "default_scope": "OWN",
      "description": "Edit your own profile",
      "is_dangerous": false,
      "max_scope": "OWN",
      "module": "profile",
      "resource": "self"
    }
