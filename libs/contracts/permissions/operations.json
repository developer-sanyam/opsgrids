{
  "manifest_version": 1,
  "permissions": [
    {
      "action": "execute",
      "default_scope": "ORG",
      "description": "Confirm a package (posts the staging -> pack/dock relocation) and maintain packaging materials",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "fulfilment",
      "resource": "pack"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See packages, their lines and packaging materials",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "fulfilment",
      "resource": "pack"
    },
    {
      "action": "assign",
      "default_scope": "ORG",
      "description": "Create an accepted order's pick tasks, offer or reassign one to a worker, cancel a task nobody has started yet",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "fulfilment",
      "resource": "task"
    },
    {
      "action": "execute",
      "default_scope": "OWN",
      "description": "Accept/decline your own offer, scan, confirm a pick line, raise or resolve an exception \u2014 always on a task currently offered or accepted to you",
      "is_dangerous": false,
      "max_scope": "OWN",
      "module": "fulfilment",
      "resource": "task"
    },
    {
      "action": "override",
      "default_scope": "ORG",
      "description": "Cancel a task a worker already has in hand, or force-close a picked one",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "fulfilment",
      "resource": "task"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See pick tasks, their lines and offer history",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "fulfilment",
      "resource": "task"
    },
    {
      "action": "location_read",
      "default_scope": "ORG",
      "description": "See which zones a worker may be offered tasks in",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "fulfilment",
      "resource": "worker"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the worker roster and presence",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "fulfilment",
      "resource": "worker"
    },
    {
      "action": "write",
      "default_scope": "OWN",
      "description": "Create and edit worker records, and set your own presence",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "fulfilment",
      "resource": "worker"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See inventory on hand",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "item"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create, edit and delete inventory items",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "item"
    },
    {
      "action": "publish",
      "default_scope": "ORG",
      "description": "Change kind or capacity on a location already in use",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "layout"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See a warehouse's locations and their barcodes",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "location"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create locations and edit their code, name, barcode and pick sequence",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "location"
    },
    {
      "action": "adjust",
      "default_scope": "ORG",
      "description": "Adjust or count an item's stock on hand",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "stock"
    },
    {
      "action": "reconcile",
      "default_scope": "ORG",
      "description": "Check the stock ledger against balances and resolve discrepancies",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "stock"
    },
    {
      "action": "reserve",
      "default_scope": "ORG",
      "description": "Reserve stock for a demand, and release a reservation's open remainder",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "stock"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See warehouses",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "warehouse"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create, edit and delete warehouses",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "warehouse"
    },
    {
      "action": "accept",
      "default_scope": "ORG",
      "description": "Accept a placed order, reserving its stock",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "orders",
      "resource": "order"
    },
    {
      "action": "cancel",
      "default_scope": "ORG",
      "description": "Cancel an order and release its reservations",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "orders",
      "resource": "order"
    },
    {
      "action": "create",
      "default_scope": "ORG",
      "description": "Create a draft order",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "orders",
      "resource": "order"
    },
    {
      "action": "hand_over",
      "default_scope": "ORG",
      "description": "Hand an order over at the counter once the billing gate passes",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "orders",
      "resource": "order"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See orders, their lines, and price a quote",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "orders",
      "resource": "order"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Place a draft order, and hold/release an accepted one",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "orders",
      "resource": "order"
    },
    {
      "action": "approve",
      "default_scope": "ORG",
      "description": "Approve a purchase order",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "procurement",
      "resource": "purchase_order"
    },
    {
      "action": "read",
      "default_scope": "OWN",
      "description": "See purchase orders and their lines",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "procurement",
      "resource": "purchase_order"
    },
    {
      "action": "write",
      "default_scope": "OWN",
      "description": "Raise, edit and delete draft purchase orders; receive an approved one; close it; cancel a draft (cancelling an approved one also needs approve)",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "procurement",
      "resource": "purchase_order"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the supplier directory",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "procurement",
      "resource": "supplier"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create, edit and delete suppliers",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "procurement",
      "resource": "supplier"
    }
