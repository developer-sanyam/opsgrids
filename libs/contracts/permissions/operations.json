{
  "manifest_version": 1,
  "permissions": [
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See inventory on hand",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inventory",
      "resource": "item"
    },
    {
      "action": "write",
      "default_scope": "ORG",
