{
  "manifest_version": 1,
  "permissions": [
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the organization's contacts, with addresses masked",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "audience",
      "resource": "contact"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Add, edit, import and delete contacts",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "audience",
      "resource": "contact"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See contact lists and who is on them",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "audience",
      "resource": "list"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create, rename and delete contact lists, and add or remove members",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "audience",
      "resource": "list"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See which addresses may not be mailed, and why",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "audience",
      "resource": "suppression"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Suppress an address by hand, or lift a manual suppression",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "audience",
      "resource": "suppression"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See campaigns, their recipients and their delivery stats",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "campaign",
      "resource": "campaign"
    },
    {
      "action": "send",
      "default_scope": "ORG",
      "description": "Send a campaign to its audience",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "campaign",
      "resource": "campaign"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Draft, edit and delete campaigns, and cancel one in flight",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "campaign",
      "resource": "campaign"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See WhatsApp conversations and their message threads, bodies masked",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inbox",
      "resource": "conversation"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Assign and close WhatsApp conversations",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inbox",
      "resource": "conversation"
    },
    {
      "action": "reply",
      "default_scope": "ORG",
      "description": "Send a free-text WhatsApp reply inside the 24-hour service window",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "inbox",
      "resource": "message"
    },
    {
      "action": "unmask",
      "default_scope": "ORG",
      "description": "Reveal the real text of a customer's WhatsApp message (audited every time)",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "inbox",
      "resource": "message"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See how the organization sends email",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "setup",
      "resource": "connection"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Connect or disconnect the email provider",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "setup",
      "resource": "connection"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See sending domains and their DNS state",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "setup",
      "resource": "domain"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Add a sending domain and verify its DNS",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "setup",
      "resource": "domain"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the senders mail can go out as",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "setup",
      "resource": "sender"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Add and edit senders, and run the test send that makes one usable",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "setup",
      "resource": "sender"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See how the organization sends WhatsApp messages",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "setup",
      "resource": "whatsapp"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Connect or replace the organization's WhatsApp Business account",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "setup",
      "resource": "whatsapp"
    }
  ],
  "product": "engage",
  "role_templates": [
    {
      "code": "ENGAGE_ADMIN",
      "cross_product": false,
      "description": "Owns how the organization sends: the provider connection, its domains and its senders. Built from the Engage catalogue alone.",
      "grants": [
        {
          "code": "engage.audience.contact.read",
          "scope": "ORG"
        },
        {
          "code": "engage.audience.contact.write",
          "scope": "ORG"
        },
        {
          "code": "engage.audience.list.read",
          "scope": "ORG"
        },
        {
          "code": "engage.audience.list.write",
          "scope": "ORG"
        },
        {
          "code": "engage.audience.suppression.read",
          "scope": "ORG"
        },
        {
          "code": "engage.audience.suppression.write",
          "scope": "ORG"
        },
        {
          "code": "engage.campaign.campaign.read",
          "scope": "ORG"
        },
        {
          "code": "engage.campaign.campaign.send",
          "scope": "ORG"
        },
        {
          "code": "engage.campaign.campaign.write",
          "scope": "ORG"
        },
        {
          "code": "engage.inbox.conversation.read",
          "scope": "ORG"
        },
        {
          "code": "engage.inbox.conversation.write",
          "scope": "ORG"
        },
        {
          "code": "engage.inbox.message.reply",
          "scope": "ORG"
        },
        {
          "code": "engage.inbox.message.unmask",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.connection.read",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.connection.write",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.domain.read",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.domain.write",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.sender.read",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.sender.write",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.whatsapp.read",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.whatsapp.write",
          "scope": "ORG"
        }
      ],
      "is_admin": true,
      "is_default": false,
      "name": "Engage administrator"
    },
    {
      "code": "ENGAGE_VIEWER",
      "cross_product": false,
      "description": "Every person with an Engage seat. Reads the sending setup without being able to change it \u2014 a new seat should not be able to repoint the organization's mail.",
      "grants": [
        {
          "code": "engage.audience.contact.read",
          "scope": "ORG"
        },
        {
          "code": "engage.audience.list.read",
          "scope": "ORG"
        },
        {
          "code": "engage.audience.suppression.read",
          "scope": "ORG"
        },
        {
          "code": "engage.campaign.campaign.read",
          "scope": "ORG"
        },
        {
          "code": "engage.inbox.conversation.read",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.connection.read",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.domain.read",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.sender.read",
          "scope": "ORG"
        },
        {
          "code": "engage.setup.whatsapp.read",
          "scope": "ORG"
        }
      ],
      "is_admin": false,
      "is_default": true,
      "name": "Engage viewer"
    },
    {
      "code": "ENGAGE_INBOX_AGENT",
      "cross_product": false,
      "description": "Works the WhatsApp inbox: reads conversations, replies inside the service window, assigns and closes threads. No unmasking of a customer's message history, and no sending setup or campaigns.",
      "grants": [
        {
          "code": "engage.inbox.conversation.read",
          "scope": "ORG"
        },
        {
          "code": "engage.inbox.conversation.write",
          "scope": "ORG"
        },
        {
          "code": "engage.inbox.message.reply",
          "scope": "ORG"
        }
      ],
      "is_admin": false,
      "is_default": false,
      "name": "Engage inbox agent"
    }
  ],
  "sources": [
    "notification"
  ]
}
