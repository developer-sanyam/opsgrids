{
  "manifest_version": 1,
  "permissions": [
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the product and category catalogue \u2014 products, their variants and categories",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "catalogue",
      "resource": "product"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create, edit, archive and delete products, their variants, and categories",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "catalogue",
      "resource": "product"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See delivery zones and their postal codes, test a postal code, and read the out-of-zone demand report",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "delivery",
      "resource": "zone"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Create and edit delivery zones, map postal codes to them, and import a postal-code file",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "delivery",
      "resource": "zone"
    },
    {
      "action": "delete",
      "default_scope": "ORG",
      "description": "Permanently erase an enquiry, with the buyer's contact details and WhatsApp opt-in it holds",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "sales",
      "resource": "enquiry"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See enquiries and their status, with buyer contact details masked",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "sales",
      "resource": "enquiry"
    },
    {
      "action": "unmask",
      "default_scope": "ORG",
      "description": "Reveal an enquiry's real email and phone number (audited)",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "sales",
      "resource": "enquiry"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Change an enquiry's status (new, contacted, won, lost)",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "sales",
      "resource": "enquiry"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the store's identity \u2014 its name, tagline, logo text, address, status, currency, timezone and custom-domain claim",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "store",
      "resource": "settings"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Change the store's name, brand and settings, claim a custom domain, and publish or unpublish the store \u2014 the act that makes it visible to anyone",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "store",
      "resource": "settings"
    }
  ],
  "product": "storefront",
  "role_templates": [
    {
      "code": "STOREFRONT_ADMIN",
      "cross_product": false,
      "description": "Runs the store: its published identity, its delivery map, its catalogue and its enquiries. Built from the Storefront catalogue alone \u2014 publishing a store is not the same job as owning the account.",
      "grants": [
        {
          "code": "storefront.catalogue.product.read",
          "scope": "ORG"
        },
        {
          "code": "storefront.catalogue.product.write",
          "scope": "ORG"
        },
        {
          "code": "storefront.delivery.zone.read",
          "scope": "ORG"
        },
        {
          "code": "storefront.delivery.zone.write",
          "scope": "ORG"
        },
        {
          "code": "storefront.sales.enquiry.delete",
          "scope": "ORG"
        },
        {
          "code": "storefront.sales.enquiry.read",
          "scope": "ORG"
        },
        {
          "code": "storefront.sales.enquiry.unmask",
          "scope": "ORG"
        },
        {
          "code": "storefront.sales.enquiry.write",
          "scope": "ORG"
        },
        {
          "code": "storefront.store.settings.read",
          "scope": "ORG"
        },
        {
          "code": "storefront.store.settings.write",
          "scope": "ORG"
        }
      ],
      "is_admin": true,
      "is_default": false,
      "name": "Storefront administrator"
    },
    {
      "code": "STOREFRONT_STAFF",
      "cross_product": false,
      "description": "Every person with a Storefront seat. Reads the store's settings, its delivery zones and its catalogue, including which postal codes were turned away, and changes neither. Holds no enquiry permission \u2014 enquiries carry buyer PII and stay with the admin role until a narrower reading is asked for.",
      "grants": [
        {
          "code": "storefront.catalogue.product.read",
          "scope": "ORG"
        },
        {
          "code": "storefront.delivery.zone.read",
          "scope": "ORG"
        },
        {
          "code": "storefront.store.settings.read",
          "scope": "ORG"
        }
      ],
      "is_admin": false,
      "is_default": true,
      "name": "Storefront staff"
    }
  ],
  "sources": [
    "storefront"
  ]
}
