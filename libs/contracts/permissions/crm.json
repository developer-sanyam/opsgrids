          "scope": "OWN"
        },
        {
          "code": "crm.book.contact.read",
          "scope": "ORG"
        },
        {
          "code": "crm.book.contact.write",
          "scope": "OWN"
        }
      ],
      "is_admin": false,
      "is_default": true,
      "name": "Sales representative"
