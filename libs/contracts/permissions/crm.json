      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "book",
      "resource": "owner"
    },
    {
      "action": "read",
      "default_scope": "OWN",
      "description": "See the activity timeline",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "pipeline",
      "resource": "activity"
    },
    {
      "action": "write",
      "default_scope": "OWN",
      "description": "Log calls, emails, meetings and notes",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "pipeline",
      "resource": "activity"
    },
    {
      "action": "delete",
      "default_scope": "OWN",
      "description": "Delete a deal",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "pipeline",
      "resource": "deal"
    },
    {
      "action": "read",
      "default_scope": "OWN",
      "description": "See deals and the pipeline summary",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "pipeline",
      "resource": "deal"
