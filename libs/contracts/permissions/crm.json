  "permissions": [
    {
      "action": "delete",
      "default_scope": "OWN",
      "description": "Delete a company",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "book",
      "resource": "company"
    },
    {
      "action": "read",
      "default_scope": "OWN",
      "description": "See companies and the rep directory",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "book",
      "resource": "company"
    },
    {
      "action": "write",
      "default_scope": "OWN",
      "description": "Create and update companies",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "book",
      "resource": "company"
    },
    {
      "action": "delete",
      "default_scope": "OWN",
