      "max_scope": "ORG",
      "module": "book",
      "resource": "contact"
    },
    {
      "action": "write",
      "default_scope": "OWN",
      "description": "Create and update contacts",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "book",
      "resource": "contact"
    },
    {
      "action": "write",
      "default_scope": "ORG",
