  "product": "crm",
  "role_templates": [
    {
      "code": "CRM_BOOK_ADMIN",
      "cross_product": false,
      "description": "Administers the whole account book across the organization. Built from this service's own slice of the CRM catalogue alone \u2014 administering the CRM is not the same job as owning the account.",
      "grants": [
        {
          "code": "crm.book.company.delete",
          "scope": "ORG"
        },
        {
          "code": "crm.book.company.read",
          "scope": "ORG"
        },
        {
          "code": "crm.book.company.write",
          "scope": "ORG"
        },
        {
          "code": "crm.book.contact.delete",
          "scope": "ORG"
        },
        {
          "code": "crm.book.contact.read",
          "scope": "ORG"
        },
        {
          "code": "crm.book.contact.read_sensitive",
          "scope": "ORG"
        },
        {
          "code": "crm.book.contact.write",
          "scope": "ORG"
        },
        {
          "code": "crm.book.owner.write",
          "scope": "ORG"
        }
      ],
      "is_admin": true,
      "is_default": false,
      "name": "CRM administrator (book)"
    },
    {
