{
  "manifest_version": 1,
  "permissions": [
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See customers and their receivables",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "billing",
      "resource": "customer"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See invoices and credit notes",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "billing",
      "resource": "invoice"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See payments received",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "billing",
      "resource": "payment"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See e-invoice filing status and history",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "einvoice"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See e-Way bills and their validity",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "eway"
    },
    {
      "action": "decide",
      "default_scope": "ORG",
      "description": "Accept, reject or park an inbound supplier document",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "ims"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the IMS reconciliation queue and its suggestions",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "ims"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the organization's GST registration",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "registration"
    },
    {
      "action": "write",
      "default_scope": "ORG",
      "description": "Set the organization's GST registration",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "registration"
    },
    {
      "action": "file",
      "default_scope": "ORG",
      "description": "Mark a generated GST return as filed with the portal",
      "is_dangerous": true,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "returns"
    },
    {
      "action": "generate",
      "default_scope": "ORG",
      "description": "Assemble a GST return from the invoices recorded for a period",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "returns"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See generated and filed GST returns",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "returns"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See TDS deducted and TCS collected per document",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "compliance",
      "resource": "withholding"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the ledger / trial balance",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "reports",
      "resource": "ledger"
    },
    {
      "action": "read",
      "default_scope": "ORG",
      "description": "See the finance overview / KPIs",
      "is_dangerous": false,
      "max_scope": "ORG",
      "module": "reports",
      "resource": "summary"
    }
