    "/api/v1/leads/{lead_id}:convert": {
      "post": {
        "description": "Idempotent: converting an already-converted lead returns the same ids rather than\nerroring or duplicating anything (`services.convert_lead`, `domain.conversion_ids`).\n\nUses the raw session rather than the tenant chokepoint's one-transaction-per-request \u2014\n`services.convert_lead` opens and binds its own three transactions (claim, then the two\ncalls to customer's and deal's `/internal/v1` with no transaction open, then record), so\nno transaction should already be open when it is called. `NotFoundProblem` for an unknown\nlead and the OWN-scope object-level check both happen inside `services.claim_conversion`\nnow, the same checks the old single-transaction version made here before calling in.",
        "operationId": "convert_lead_api_v1_leads__lead_id__convert_post",
        "parameters": [
          {
            "in": "path",
            "name": "lead_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Lead Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadConvertOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Convert a qualified lead into a company and a deal",
        "tags": [
          "lead"
        ]
      }
    },
    "/api/v1/leads/{lead_id}:reveal": {
      "post": {
        "description": "The only public route that returns a lead's real phone number or email.\n\nA POST rather than a GET on purpose: it has a side effect \u2014 it writes an\n`entity.sensitive_read` audit row naming the field \u2014 and it must never be cached,\npre-fetched, logged in a query string or replayed from browser history the way a GET can\nbe. The response says so itself (`Cache-Control: no-store`).\n\nGuarded by the dangerous `read_sensitive` permission and a step-up token (`_reveal_guard`),\nthen re-scoped to this one lead inside `services.reveal_lead_field`, which also owns the\nnot-found, the nothing-on-file, the per-user reveal budget and the audit steps. This route\ntakes the ordinary tenant session, so the audit row commits before the response is sent.",
        "operationId": "reveal_lead_field_api_v1_leads__lead_id__reveal_post",
        "parameters": [
          {
            "in": "path",
            "name": "lead_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Lead Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadRevealIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadRevealOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Missing `crm.lead.lead.read_sensitive`, a step-up token (`Additional authentication required: otp, stepup` \u2014 a session that gave a code at sign-in is not enough; `POST /auth/mfa/step-up` mints one), or the lead is outside the caller's scope."
          },
          "404": {
            "description": "The lead is not part of this organization, or it has no value on file for the requested field."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "This user has spent their reveal budget in this organization: 30 per 10 minutes or 200 per day, shared with the contact reveal. Only a request that would have revealed a value spends from it. `Retry-After` is the length of the window that was spent, in seconds."
          },
          "503": {
            "description": "The budget could not be checked (Redis is unreachable), so nothing is revealed. Retry shortly."
          }
        },
        "summary": "Reveal a lead's real phone number or email (audited)",
        "tags": [
          "lead"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
