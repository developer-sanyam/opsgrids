{
  "components": {
    "schemas": {
      "AssignmentRuleIn": {
        "additionalProperties": false,
        "description": "Configure the organization's round-robin. ORG-scoped: this is workspace\nconfiguration, not any one rep's record (see `app/services.py`).",
        "properties": {
          "mode": {
            "default": "round_robin",
            "enum": [
              "round_robin",
              "manual"
            ],
            "title": "Mode",
            "type": "string"
          },
          "owner_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 200,
            "title": "Owner Ids",
            "type": "array"
          }
        },
        "title": "AssignmentRuleIn",
        "type": "object"
      },
      "AssignmentRuleOut": {
        "properties": {
          "cursor": {
            "title": "Cursor",
            "type": "integer"
          },
          "mode": {
            "enum": [
              "round_robin",
              "manual"
            ],
            "title": "Mode",
            "type": "string"
          },
          "owner_ids": {
            "items": {
              "type": "string"
            },
            "title": "Owner Ids",
            "type": "array"
          }
        },
        "required": [
          "mode",
          "owner_ids",
          "cursor"
        ],
        "title": "AssignmentRuleOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LeadConvertOut": {
        "description": "The result of `:convert` \u2014 the ids the lead became. Returned identically whether this\ncall performed the conversion or a lead already converted is being replayed.",
        "properties": {
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "contact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id"
          },
          "deal_id": {
            "title": "Deal Id",
            "type": "string"
          },
          "lead_id": {
            "title": "Lead Id",
            "type": "string"
          }
        },
        "required": [
          "lead_id",
          "company_id",
          "contact_id",
          "deal_id"
        ],
        "title": "LeadConvertOut",
        "type": "object"
      },
      "LeadIn": {
        "additionalProperties": false,
        "description": "Capture a lead \u2014 from a web form, an import row or a rep typing one in by hand.\n\n`owner_id` is optional: an omitted one is auto-assigned from the organization's\n`AssignmentRule` (round-robin), matching how a form submission has no rep to name.\n`email` / `phone` are the raw values on the way in; they are sealed and masked before\nanything is stored (see `app/models.py`), and never echoed back raw.",
        "properties": {
          "company": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "email": {
            "anyOf": [
              {
                "format": "email",
                "maxLength": 254,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "notes": {
            "default": "",
            "maxLength": 4000,
            "title": "Notes",
            "type": "string"
          },
          "owner_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "source": {
            "default": "manual",
            "enum": [
              "form",
              "import",
              "manual"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "full_name"
        ],
        "title": "LeadIn",
        "type": "object"
      },
      "LeadOut": {
        "properties": {
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "converted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Converted At"
          },
          "converted_company_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Converted Company Id"
          },
          "converted_contact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Converted Contact Id"
          },
          "converted_deal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Converted Deal Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "notes": {
            "title": "Notes",
            "type": "string"
          },
          "owner_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "source": {
            "enum": [
              "form",
              "import",
              "manual"
            ],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "new",
              "working",
              "qualified",
              "disqualified",
              "converted"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "full_name",
          "company",
          "email",
          "phone",
          "source",
          "status",
          "owner_id",
          "notes",
          "converted_company_id",
          "converted_contact_id",
          "converted_deal_id",
          "converted_at",
          "created_at"
        ],
        "title": "LeadOut",
        "type": "object"
      },
      "LeadPatch": {
        "additionalProperties": false,
        "description": "Partial update of a lead's plain fields and its status. Deliberately **no path to\n`converted`** \u2014 `status` here is validated against `domain.can_transition`, which has no\ntransition landing on `converted`; only `POST /leads/{id}:convert` can set it, because\nthat is the one path that also creates the company and deal the status implies.",
        "properties": {
          "company": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "owner_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "new",
                  "working",
                  "qualified",
                  "disqualified",
                  "converted"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "title": "LeadPatch",
        "type": "object"
      },
      "LeadRevealIn": {
        "additionalProperties": false,
        "description": "Which sealed detail to reveal. One route serves both, so the client has a single call\nand the audit row names exactly the field that was opened. Anything but `phone` or\n`email` is a 422 \u2014 there is no way to ask this route for some other column.",
        "properties": {
          "field": {
            "enum": [
              "phone",
              "email"
            ],
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "title": "LeadRevealIn",
        "type": "object"
      },
      "LeadRevealOut": {
        "description": "A lead's real phone number or email, revealed to a human who stepped up.\n\nReturned only by `POST /leads/{id}:reveal`, which requires the dangerous\n`crm.lead.lead.read_sensitive` permission and a second factor, and which writes an audit\nrow every time. `value` is always present: a lead with nothing sealed for the requested\nfield is a 404, never a 200 with a null. The response is sent `Cache-Control: no-store`.",
        "properties": {
          "field": {
            "enum": [
              "phone",
              "email"
            ],
            "title": "Field",
            "type": "string"
          },
          "lead_id": {
            "title": "Lead Id",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "lead_id",
          "field",
          "value"
        ],
        "title": "LeadRevealOut",
        "type": "object"
      },
      "Page_LeadOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LeadOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size",
          "pages"
        ],
        "title": "Page[LeadOut]",
        "type": "object"
      },
      "ServiceInfo": {
        "properties": {
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "schema_name"
        ],
        "title": "ServiceInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
