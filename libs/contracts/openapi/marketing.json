          "channels": {
            "items": {
              "$ref": "#/components/schemas/ChannelPerformance"
            },
            "title": "Channels",
            "type": "array"
          },
          "conversions": {
            "title": "Conversions",
            "type": "integer"
          },
          "cpl_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cpl Minor"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "leads": {
            "title": "Leads",
            "type": "integer"
          },
          "pipeline_minor": {
            "title": "Pipeline Minor",
            "type": "integer"
          },
          "revenue_minor": {
            "title": "Revenue Minor",
            "type": "integer"
          },
          "revenue_vs_spend": {
            "items": {
