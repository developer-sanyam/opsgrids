{
  "components": {
    "schemas": {
      "AudienceIn": {
        "description": "Create a saved audience segment.",
        "properties": {
          "created_at": {
            "format": "date",
            "title": "Created At",
            "type": "string"
          },
          "criteria": {
            "default": "",
            "maxLength": 400,
            "title": "Criteria",
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "size": {
            "minimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "size",
          "created_at"
        ],
        "title": "AudienceIn",
        "type": "object"
      },
      "AudienceOut": {
        "description": "A saved audience segment. `created_at` is the segment's definition date (a plain date),\nnot the row's write timestamp.",
        "properties": {
          "created_at": {
            "format": "date",
            "title": "Created At",
            "type": "string"
          },
          "criteria": {
            "title": "Criteria",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "size",
          "criteria",
          "created_at"
        ],
        "title": "AudienceOut",
        "type": "object"
      },
      "CampaignIn": {
        "description": "Create a campaign.\n\nMoney arrives as minor units, matching how it is stored and returned. `audience_id` must name\nan audience in the same organization \u2014 enforced in `services`, so naming another tenant's\naudience reads as \"not found\" rather than resolving.",
        "properties": {
          "audience_id": {
            "format": "uuid",
            "title": "Audience Id",
            "type": "string"
          },
          "budget_minor": {
            "default": 0,
            "minimum": 0.0,
            "title": "Budget Minor",
            "type": "integer"
          },
          "channel": {
            "enum": [
              "email",
              "social",
              "search",
              "events"
            ],
            "title": "Channel",
            "type": "string"
          },
          "conversions": {
            "default": 0,
            "minimum": 0.0,
            "title": "Conversions",
            "type": "integer"
          },
          "currency": {
            "default": "INR",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "end_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "goal": {
            "default": "",
            "maxLength": 200,
            "title": "Goal",
            "type": "string"
          },
          "leads": {
            "default": 0,
            "minimum": 0.0,
            "title": "Leads",
            "type": "integer"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "owner": {
            "default": "",
            "maxLength": 120,
            "title": "Owner",
            "type": "string"
          },
          "pipeline_minor": {
            "default": 0,
            "minimum": 0.0,
            "title": "Pipeline Minor",
            "type": "integer"
          },
          "revenue_minor": {
            "default": 0,
            "minimum": 0.0,
            "title": "Revenue Minor",
            "type": "integer"
          },
          "spent_minor": {
            "default": 0,
            "minimum": 0.0,
            "title": "Spent Minor",
            "type": "integer"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "status": {
            "default": "draft",
            "enum": [
              "draft",
              "live",
              "paused",
              "ended"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "channel",
          "audience_id",
          "start_date"
        ],
        "title": "CampaignIn",
        "type": "object"
      },
      "CampaignOut": {
        "description": "A campaign, shaped exactly as `types.ts#Campaign`. All amounts are minor units of\n`currency`; the derived ratios are computed client-side (and server-side in the rollups).",
        "properties": {
          "audience_id": {
            "format": "uuid",
            "title": "Audience Id",
            "type": "string"
          },
          "budget_minor": {
            "title": "Budget Minor",
            "type": "integer"
          },
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "conversions": {
            "title": "Conversions",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "end_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "leads": {
            "title": "Leads",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner": {
            "title": "Owner",
            "type": "string"
          },
          "pipeline_minor": {
            "title": "Pipeline Minor",
            "type": "integer"
          },
          "revenue_minor": {
            "title": "Revenue Minor",
            "type": "integer"
          },
          "spent_minor": {
            "title": "Spent Minor",
            "type": "integer"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "channel",
          "status",
          "currency",
          "budget_minor",
          "spent_minor",
          "revenue_minor",
          "pipeline_minor",
          "leads",
          "conversions",
          "goal",
          "audience_id",
          "start_date",
          "end_date",
          "owner"
        ],
        "title": "CampaignOut",
        "type": "object"
      },
      "ChannelPerformance": {
        "description": "One channel's rolled-up performance across the org's campaigns.\n\n`roas` is a plain ratio (revenue / spend), `0` when there is no spend. `cac_minor` and\n`cpl_minor` are minor units and `null` when their denominator (conversions, leads) is zero \u2014\nthe same divide-by-zero contract the SPA's `derive.ts` uses.",
        "properties": {
          "cac_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cac Minor"
          },
          "campaigns": {
            "title": "Campaigns",
            "type": "integer"
          },
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "conversions": {
            "title": "Conversions",
            "type": "integer"
          },
          "cpl_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cpl Minor"
          },
          "leads": {
            "title": "Leads",
            "type": "integer"
          },
          "pipeline_minor": {
            "title": "Pipeline Minor",
            "type": "integer"
          },
          "revenue_minor": {
            "title": "Revenue Minor",
            "type": "integer"
          },
          "roas": {
            "title": "Roas",
            "type": "number"
          },
          "spend_minor": {
            "title": "Spend Minor",
            "type": "integer"
          }
        },
        "required": [
          "channel",
          "campaigns",
          "spend_minor",
          "revenue_minor",
          "pipeline_minor",
          "leads",
          "conversions",
          "roas",
          "cac_minor",
          "cpl_minor"
        ],
        "title": "ChannelPerformance",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OverviewSummary": {
        "description": "The Overview screen in one payload: the four KPI headlines, the revenue-vs-spend series,\nand the per-channel breakdown. Every figure is derived server-side from the same campaign set\nand monthly series the list endpoints expose, so the number here and the number the SPA\nderives from the lists cannot disagree.",
