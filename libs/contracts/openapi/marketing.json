            "title": "Revenue Vs Spend",
            "type": "array"
          },
          "roas": {
            "title": "Roas",
            "type": "number"
          },
          "spend_minor": {
            "title": "Spend Minor",
            "type": "integer"
          }
        },
        "required": [
          "currency",
          "revenue_minor",
          "spend_minor",
          "pipeline_minor",
          "leads",
          "conversions",
          "roas",
          "cpl_minor",
          "revenue_vs_spend",
          "channels"
        ],
        "title": "OverviewSummary",
        "type": "object"
      },
      "Page_AudienceOut_": {
