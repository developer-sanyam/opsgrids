                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchased At"
          },
          "serial": {
            "title": "Serial",
            "type": "string"
          },
          "status": {
            "enum": [
              "in_use",
              "in_stock",
              "in_repair",
              "retired"
            ],
            "title": "Status",
            "type": "string"
          },
          "tag": {
            "title": "Tag",
            "type": "string"
          },
          "type": {
            "enum": [
              "laptop",
              "desktop",
              "server",
              "monitor",
              "phone",
              "network",
              "license"
            ],
            "title": "Type",
            "type": "string"
          },
          "warranty_expires_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warranty Expires At"
