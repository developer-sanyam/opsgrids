{
  "components": {
    "schemas": {
      "AssetIn": {
        "description": "Create a CMDB asset.",
        "properties": {
          "cost_currency": {
            "default": "INR",
            "maxLength": 3,
            "minLength": 3,
            "title": "Cost Currency",
            "type": "string"
          },
          "cost_minor": {
            "default": 0,
            "minimum": 0.0,
            "title": "Cost Minor",
            "type": "integer"
          },
          "location": {
            "default": "",
            "maxLength": 160,
            "title": "Location",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner"
          },
          "purchased_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchased At"
          },
          "serial": {
            "default": "",
            "maxLength": 120,
            "title": "Serial",
            "type": "string"
          },
          "status": {
            "default": "in_stock",
            "enum": [
              "in_use",
              "in_stock",
              "in_repair",
              "retired"
            ],
            "title": "Status",
            "type": "string"
          },
          "tag": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Tag",
            "type": "string"
          },
          "type": {
            "enum": [
              "laptop",
              "desktop",
              "server",
              "monitor",
              "phone",
              "network",
              "license"
            ],
            "title": "Type",
            "type": "string"
          },
          "warranty_expires_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warranty Expires At"
          }
        },
        "required": [
          "tag",
          "name",
          "type"
        ],
        "title": "AssetIn",
        "type": "object"
      },
      "AssetOut": {
        "description": "Mirrors the SPA's `Asset`. Keyed by `tag`; cost is minor units in `cost_currency`.\n`open_incident_ids` is derived from the incidents currently open against this asset.",
