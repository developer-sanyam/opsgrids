        "title": "PlanOut",
        "type": "object"
      },
      "PlanPatchIn": {
        "description": "Editing a plan touches only its presentation. Re-pricing is a new version, never a\nfield update \u2014 that is what keeps published versions reconstructable (ADR-0000 \u00a79).",
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "sort_order": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sort Order"
          }
        },
        "title": "PlanPatchIn",
        "type": "object"
      },
      "PlanVersionOut": {
        "description": "A priced snapshot. `restricted_to_org_id` is echoed so an operator UI can see an\naudience-of-one at a glance; the customer read only ever returns versions the caller is\nallowed to see, so for them it is either NULL or their own organization.",
        "properties": {
          "billing_interval": {
            "title": "Billing Interval",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureOut"
            },
            "title": "Features",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/PriceOut"
            },
            "title": "Prices",
            "type": "array"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "restricted_to_org_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restricted To Org Id"
          },
          "seat_classes": {
            "items": {
              "$ref": "#/components/schemas/SeatClassOut"
            },
            "title": "Seat Classes",
            "type": "array"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "version_no": {
            "title": "Version No",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version_no",
          "state",
          "billing_interval",
          "currency"
        ],
        "title": "PlanVersionOut",
        "type": "object"
      },
      "PriceIn": {
        "properties": {
          "amount_minor": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Minor"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "kind": {
            "pattern": "^(flat|per_seat|usage)$",
            "title": "Kind",
            "type": "string"
          },
          "meter_key": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meter Key"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "unit_price_micros": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price Micros"
          }
        },
        "required": [
          "kind",
          "currency"
        ],
        "title": "PriceIn",
        "type": "object"
      },
      "PriceOut": {
        "properties": {
          "amount_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Minor"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "meter_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meter Key"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "unit_price_micros": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price Micros"
          }
        },
        "required": [
          "kind",
          "currency"
        ],
        "title": "PriceOut",
        "type": "object"
      },
      "SeatClassIn": {
        "description": "A class of seat to author on the new version.\n\n`price_index` points at a position in the **same payload's** `prices` list rather than at a\nprice id, because the prices do not exist yet when the version is drafted. Left NULL the\nclass is free \u2014 which is the shape of the view-only seat the market now expects, and it is\nfree by having no price at all rather than a zero-amount one.",
        "properties": {
          "can_write": {
            "default": true,
            "title": "Can Write",
            "type": "boolean"
          },
          "code": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "included_count": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Included Count"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "price_index": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Index into this payload's `prices`; NULL means free",
            "title": "Price Index"
          },
          "sort_order": {
            "default": 100,
            "title": "Sort Order",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "title": "SeatClassIn",
        "type": "object"
      },
      "SeatClassOut": {
        "description": "A class of seat this version sells. `price_id` NULL is a free class.\n\n`can_write` is on the wire because it is the *entitlement* half of the seat class, not a\npresentational one: a client rendering a seat picker has to be able to say \"view-only\" out\nloud, and the grant computed server-side for such a seat contains no write permission\n(`domain.seat_class_grants`).",
        "properties": {
          "can_write": {
            "title": "Can Write",
            "type": "boolean"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "included_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Included Count"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Id"
          },
          "sort_order": {
            "title": "Sort Order",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "name",
          "can_write",
          "sort_order"
        ],
        "title": "SeatClassOut",
        "type": "object"
      },
      "ServiceInfo": {
        "properties": {
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "schema_name"
        ],
        "title": "ServiceInfo",
        "type": "object"
      },
      "TenantPlanOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "product_key": {
            "title": "Product Key",
            "type": "string"
          },
          "sort_order": {
            "title": "Sort Order",
            "type": "integer"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/TenantPlanVersionOut"
            },
            "title": "Versions",
            "type": "array"
          }
        },
        "required": [
          "id",
          "product_key",
          "code",
          "name",
          "state",
          "sort_order"
        ],
        "title": "TenantPlanOut",
        "type": "object"
      },
      "TenantPlanVersionOut": {
        "description": "A priced-snapshot's packaging, as a tenant may see it \u2014 no amount, no currency.\n\n`restricted_to_org_id` is still echoed: the customer read only ever returns versions the\ncaller is allowed to see, so for them it is either NULL or their own organization, and that\nis not pricing information.",
        "properties": {
          "billing_interval": {
            "title": "Billing Interval",
            "type": "string"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureOut"
            },
            "title": "Features",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/TenantPriceOut"
            },
            "title": "Prices",
            "type": "array"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "restricted_to_org_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restricted To Org Id"
          },
          "seat_classes": {
            "items": {
              "$ref": "#/components/schemas/SeatClassOut"
            },
            "title": "Seat Classes",
            "type": "array"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "version_no": {
            "title": "Version No",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version_no",
          "state",
          "billing_interval"
        ],
        "title": "TenantPlanVersionOut",
        "type": "object"
      },
      "TenantPriceOut": {
        "description": "A price component as a tenant caller may see it \u2014 its shape, never its amount.\n\nNo `amount_minor`, `currency` or `unit_price_micros`: the owner's rule is that pricing is\nset per client by staff, so a client must not receive a list price. `kind` still tells the\nclient a flat offer exists to start a trial against, without saying what it costs.",
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "meter_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meter Key"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "required": [
          "kind"
        ],
        "title": "TenantPriceOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionCreateIn": {
        "description": "Clone the plan's active version into a new draft, with these prices and features.\n\n`restricted_to_org_id` set makes it a bespoke, audience-of-one version (ADR-0004 \u00a72);\nleft NULL it is a public version every customer of the product can see once published. The\nsame field, pointed at a reseller's organization, is how a partner wholesale price is\nauthored \u2014 one mechanism, two commercial uses (docs/commerce-packaging.md).\n\nA **bundle** is authored here too, with no special field: its `features` declare\n`bundled_products` and `bundle_tier`, and its `prices` are the bundled rate. A bundle is a\nplan version, not a discount layered over one, which is what keeps a bundled invoice\nreconstructable from the version it pinned.",
        "properties": {
          "billing_interval": {
            "default": "month",
            "pattern": "^(month|year|one_time)$",
            "title": "Billing Interval",
            "type": "string"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureIn"
            },
            "title": "Features",
            "type": "array"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/PriceIn"
            },
            "title": "Prices",
            "type": "array"
          },
          "restricted_to_org_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restricted To Org Id"
          },
          "seat_classes": {
            "items": {
              "$ref": "#/components/schemas/SeatClassIn"
            },
            "title": "Seat Classes",
            "type": "array"
          }
        },
        "required": [
          "currency"
        ],
        "title": "VersionCreateIn",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The definitional layer of commerce: plans, immutable priced versions, and features \u2014 what can be sold. Global platform vocabulary, read by everything downstream and authored only by staff.",
    "title": "Catalog service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/catalog/plans": {
      "post": {
        "operationId": "create_plan_api_v1_admin_catalog_plans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create a plan",
        "tags": [
          "catalog-admin"
        ]
      }
    },
