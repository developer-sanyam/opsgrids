      },
      "PlanOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "product_key": {
            "title": "Product Key",
            "type": "string"
          },
          "sort_order": {
            "title": "Sort Order",
            "type": "integer"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/PlanVersionOut"
            },
            "title": "Versions",
            "type": "array"
          }
        },
        "required": [
