                  "$ref": "#/components/schemas/PlanOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Retire a plan",
        "tags": [
          "catalog-admin"
        ]
      }
    },
    "/api/v1/admin/catalog/plans/{plan_id}/versions": {
      "post": {
        "operationId": "create_version_api_v1_admin_catalog_plans__plan_id__versions_post",
        "parameters": [
          {
            "in": "path",
            "name": "plan_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Plan Id",
              "type": "string"
