{
  "components": {
    "schemas": {
      "ActivateIn": {
        "properties": {
          "product_key": {
            "title": "Product Key",
            "type": "string"
          },
          "trial_days": {
            "anyOf": [
              {
                "maximum": 365.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Days"
          }
        },
        "required": [
          "product_key"
        ],
        "title": "ActivateIn",
        "type": "object"
      },
      "ActivationOut": {
        "description": "What an organization has, and whether it currently counts.\n\n`entitles` is computed rather than stored, so a lapsed trial reads as false the moment it\nlapses. A client showing `status` alone would tell somebody they still have a product the\ngateway is already refusing.",
        "properties": {
          "activated_at": {
            "format": "date-time",
            "title": "Activated At",
            "type": "string"
          },
          "deactivated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deactivated At"
          },
          "entitles": {
            "title": "Entitles",
            "type": "boolean"
          },
          "product_key": {
            "title": "Product Key",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "trial_ends_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Ends At"
          }
        },
        "required": [
          "product_key",
          "status",
          "entitles",
          "activated_at"
        ],
        "title": "ActivationOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProductOut": {
        "description": "One entry in the marketplace.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "connects_to": {
            "items": {
              "type": "string"
            },
            "title": "Connects To",
            "type": "array"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "is_platform": {
            "default": false,
            "title": "Is Platform",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tagline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tagline"
          }
        },
        "required": [
          "key",
          "name",
          "status"
        ],
        "title": "ProductOut",
        "type": "object"
      },
      "ServiceInfo": {
        "properties": {
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          },
