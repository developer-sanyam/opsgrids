  "info": {
    "description": "The registry of what exists to sell and who has activated it. Every 402 in the platform traces back to a row this service owns.",
    "title": "Product service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/product/info": {
      "get": {
        "operationId": "info_api_v1_product_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this service is",
        "tags": [
          "product"
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "description": "Every product on the platform, not only the ones this customer has.\n\nThat is what makes it a marketplace. `status` distinguishes what can be bought now from\nwhat is coming, so a client never offers an activation that would be refused.",
        "operationId": "list_products_api_v1_products_get",
        "parameters": [
          {
            "description": "Hide beta and unreleased",
            "in": "query",
            "name": "available_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "Hide beta and unreleased",
              "title": "Available Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductOut"
                  },
                  "title": "Response List Products Api V1 Products Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The marketplace",
        "tags": [
          "product"
        ]
      }
    },
    "/api/v1/products/activations": {
      "get": {
        "operationId": "list_activations_api_v1_products_activations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ActivationOut"
                  },
                  "title": "Response List Activations Api V1 Products Activations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this organization has activated",
        "tags": [
          "product"
        ]
      },
      "post": {
        "operationId": "activate_api_v1_products_activations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activate a product",
        "tags": [
          "product"
        ]
      }
    },
    "/api/v1/products/activations/{product_key}": {
      "delete": {
        "operationId": "deactivate_api_v1_products_activations__product_key__delete",
        "parameters": [
          {
            "in": "path",
            "name": "product_key",
            "required": true,
            "schema": {
              "title": "Product Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deactivate a product",
        "tags": [
          "product"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness \u2014 is the process up?",
        "tags": [
          "health"
        ]
      }
    },
    "/health/outbox": {
      "get": {
        "description": "How far behind the relay is. **Alert on `oldest_seconds`.**\n\nA stalled relay is the platform's quietest failure. It selects, finds nothing,\nlogs nothing, sleeps, and loops \u2014 `attempts` never increments and `last_error`\nstays null, so the process looks healthy indefinitely while the outbox grows\nwithout bound and every consumer downstream starves.\n\nDeliberately **not** part of readiness. A backlog is not a reason to take the\nservice out of rotation: refusing traffic would stop new events being written\nwithout helping drain the ones already queued, which makes the incident worse.\nThis is a metric to alert on, not a health state.\n\nCounted through the outbox engine, not the application one. The app role is\nNOBYPASSRLS and this request binds no tenant, so through it `pending` would be\nzero whatever the table holds \u2014 the probe that exists to expose the stall would\nbe wired to the same blind spot that causes it.",
        "operationId": "outbox_health_outbox_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Outbox Health Outbox Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Outbox depth and age \u2014 scrape this",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Route traffic on this; restart on /health.\n\nConflating the two restarts a healthy process that is merely waiting on a\ndependency.\n\nOnly the dependencies a service actually declares are checked. A gateway owns no\ntables, so asking it for a database is asking a question whose answer means nothing\n\u2014 and a readiness probe that reports on something the service does not use is worse\nthan no probe, because it will eventually fail for a reason nobody can act on.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness \u2014 can it serve traffic?",
        "tags": [
          "health"
        ]
      }
    }
  }
}
