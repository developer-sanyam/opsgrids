              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One message and its attempt ledger",
        "tags": [
          "notification"
        ]
      }
    },
