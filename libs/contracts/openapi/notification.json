  "info": {
    "description": "Templates, automation rules and delivery \u2014 part of the OpsGrids platform.",
    "title": "Notification service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/notifications/info": {
      "get": {
        "operationId": "info_api_v1_notifications_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this service is",
        "tags": [
          "notification"
        ]
      }
    },
    "/api/v1/notifications/messages": {
      "get": {
        "operationId": "list_messages_api_v1_notifications_messages_get",
        "parameters": [
          {
            "description": "pending, sending, sent, failed or suppressed",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "pending, sending, sent, failed or suppressed",
              "title": "State"
            }
          },
          {
            "in": "query",
            "name": "channel",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Channel"
            }
          },
          {
            "description": "Recipient or subject",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Recipient or subject",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_MessageOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "What was sent, and whether it arrived",
        "tags": [
          "notification"
        ]
      },
      "post": {
        "description": "202, not 201: the message is *staged*, and the dispatcher sends it.\n\nReturning 201 would claim a delivery this request cannot know about \u2014 the provider has not\nbeen called yet and will not be until the transaction commits.",
        "operationId": "send_message_api_v1_notifications_messages_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send a message now, outside any rule",
        "tags": [
          "notification"
        ]
      }
    },
    "/api/v1/notifications/messages/{message_id}": {
      "get": {
        "operationId": "read_message_api_v1_notifications_messages__message_id__get",
        "parameters": [
