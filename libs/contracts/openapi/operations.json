            "title": "Tone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "detail",
          "href",
          "tone"
        ],
        "title": "AttentionItem",
        "type": "object"
      },
      "CategorySpend": {
        "description": "One category's share of committed spend \u2014 grouped from purchase orders. Mirrors the\nSPA's `CategorySpend`.",
        "properties": {
          "key": {
            "enum": [
              "raw_materials",
