  "components": {
    "schemas": {
      "AttentionItem": {
        "description": "One row in the \"needs attention\" queue. Mirrors the SPA's `AttentionItem`.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "href": {
            "title": "Href",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "low_stock",
              "out_of_stock",
              "late_delivery"
