  "info": {
    "description": "Operations service \u2014 part of the Atmora platform.",
    "title": "Operations service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/operations/info": {
      "get": {
        "operationId": "info_api_v1_operations_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this service is",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/v1/operations/inventory": {
      "get": {
        "operationId": "list_inventory_api_v1_operations_inventory_get",
        "parameters": [
          {
            "description": "SKU, name or warehouse",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "SKU, name or warehouse",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "warehouse",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Warehouse"
            }
          },
          {
            "description": "Only items at/under reorder point",
            "in": "query",
            "name": "low_stock",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only items at/under reorder point",
              "title": "Low Stock"
            }
          },
          {
            "description": "on_hand | value | sku",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "on_hand | value | sku",
              "title": "Sort"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_InventoryItemOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inventory on hand (low-stock is derived, and labelled \u2014 never colour alone)",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/v1/operations/overview": {
      "get": {
        "operationId": "overview_api_v1_operations_overview_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Procurement & inventory overview rollups",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/v1/operations/purchase-orders": {
      "get": {
        "operationId": "list_purchase_orders_api_v1_operations_purchase_orders_get",
        "parameters": [
          {
            "description": "Number, supplier, raiser or warehouse",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Number, supplier, raiser or warehouse",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
