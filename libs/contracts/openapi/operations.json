        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InventoryItemOut": {
        "description": "Mirrors the SPA's `InventoryItemOut`. Stock value = `on_hand * unit_value_minor`;\nlow-stock is derived by the client (and the overview) as `on_hand <= reorder_point`.",
        "properties": {
          "category": {
            "enum": [
              "raw_materials",
              "packaging",
              "components",
              "mro",
              "logistics",
              "services"
            ],
            "title": "Category",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "on_hand": {
            "title": "On Hand",
            "type": "integer"
          },
          "reorder_point": {
            "title": "Reorder Point",
            "type": "integer"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "unit_value_minor": {
            "title": "Unit Value Minor",
            "type": "integer"
          },
          "uom": {
            "title": "Uom",
            "type": "string"
          },
          "updated_at": {
            "format": "date",
            "title": "Updated At",
            "type": "string"
          },
          "warehouse": {
            "title": "Warehouse",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "category",
          "warehouse",
          "on_hand",
          "reorder_point",
          "uom",
          "unit_value_minor",
          "currency",
          "updated_at"
        ],
        "title": "InventoryItemOut",
        "type": "object"
      },
      "OverviewOut": {
        "description": "The Operations overview's server-side rollup. The SPA can derive all of this from the\nlist endpoints; this exposes the same arithmetic once, so a reporting view can share it.\n\n`open_pos` counts POs still in flight (draft or approved); `inventory_value_minor` is the\nvalue of stock on hand; `low_stock_count` is items at or below their reorder point;\n`on_time_pct` is the spend-weighted on-time delivery rate. The series and breakdowns feed the\ncharts.",
        "properties": {
          "attention": {
            "items": {
              "$ref": "#/components/schemas/AttentionItem"
            },
            "title": "Attention",
            "type": "array"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "inventory_value_minor": {
            "title": "Inventory Value Minor",
            "type": "integer"
          },
          "low_stock_count": {
            "title": "Low Stock Count",
            "type": "integer"
          },
          "on_time_pct": {
            "title": "On Time Pct",
            "type": "number"
          },
          "open_pos": {
            "title": "Open Pos",
            "type": "integer"
          },
          "po_status_mix": {
            "items": {
              "$ref": "#/components/schemas/StatusSlice"
            },
            "title": "Po Status Mix",
            "type": "array"
          },
          "spend_by_category": {
            "items": {
              "$ref": "#/components/schemas/CategorySpend"
            },
            "title": "Spend By Category",
            "type": "array"
          },
          "spend_trend": {
            "items": {
              "$ref": "#/components/schemas/SpendPoint"
            },
            "title": "Spend Trend",
            "type": "array"
          },
          "top_suppliers": {
            "items": {
              "$ref": "#/components/schemas/SupplierSpend"
            },
            "title": "Top Suppliers",
            "type": "array"
          }
        },
        "required": [
          "open_pos",
          "inventory_value_minor",
          "low_stock_count",
          "on_time_pct",
          "currency"
        ],
        "title": "OverviewOut",
        "type": "object"
      },
