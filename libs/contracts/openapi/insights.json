  "info": {
    "description": "The cross-product insights projection behind the role dashboards (ADR-0020): a read-only, per-organization history of what the source services only ever hold as current state. A leaf \u2014 no service ever calls it, and it reads no other schema directly, only each source's own internal export route. I1: the schema, tenancy, the API shell (every widget returns its real state; no figures until I2-I9 land their own fact tables), the resumable backfill runner and the hourly snapshot sweep.",
    "title": "Insights service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/insights/activity": {
      "get": {
        "description": "No fact table exists yet to union over (ADR-0020 build plan, I2-I7), so this always\nanswers the honest empty page: `items: []`, no cursor. The gate is still real \u2014 a caller's\nadmitted kinds are computed the same way I2+'s query will filter on them\n(`selectors.visible_activity_kinds`) \u2014 nothing here waits on a fact table to be correct.",
        "operationId": "activity_api_v1_insights_activity_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "in": "query",
            "name": "products",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Products"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cross-product recent activity",
        "tags": [
          "insights"
        ]
      }
    },
    "/api/v1/insights/rankings": {
      "get": {
        "operationId": "rankings_api_v1_insights_rankings_get",
        "parameters": [
          {
