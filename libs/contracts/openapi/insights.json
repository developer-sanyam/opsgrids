            }
          },
          {
            "description": "today|this_week|this_month|this_quarter|last_30_days|last_month|custom",
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "default": "this_month",
              "description": "today|this_week|this_month|this_quarter|last_30_days|last_month|custom",
              "title": "Period",
              "type": "string"
            }
          },
          {
