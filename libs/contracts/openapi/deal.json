{
  "components": {
    "schemas": {
      "ActivityIn": {
        "description": "Log one touch against a deal. Append-only \u2014 there is no update or delete, by\ndesign \u2014 so every field here describes what happened, not what it should become.\n\n`type` is the wire name for the touch kind, matching `ActivityOut`. The deal comes\nfrom the path and the company from that deal, so neither is accepted in the body.\n`owner_id` omitted attributes the touch to the calling rep. `occurred_at` omitted is\nnow; it is carried explicitly so a touch logged after the fact keeps its real time.",
        "properties": {
          "body": {
            "anyOf": [
              {
                "maxLength": 8000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          },
          "contact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id"
          },
          "direction": {
            "anyOf": [
              {
                "enum": [
                  "inbound",
                  "outbound"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "occurred_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "owner_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "subject": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "type": {
            "default": "note",
            "enum": [
              "call",
              "email",
              "meeting",
              "note",
              "task"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "subject"
        ],
        "title": "ActivityIn",
        "type": "object"
      },
      "ActivityOut": {
        "description": "Mirrors the SPA's `Activity`. `type` is the wire name for the touch kind; exactly\none of the target ids is usually set, and the owner always is.",
        "properties": {
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          },
          "company_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Id"
          },
          "contact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id"
          },
          "deal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deal Id"
          },
          "direction": {
            "anyOf": [
              {
                "enum": [
                  "inbound",
                  "outbound"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "type": {
            "enum": [
              "call",
              "email",
              "meeting",
              "note",
              "task"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "subject",
          "body",
          "deal_id",
          "company_id",
          "contact_id",
          "owner_id",
          "occurred_at",
          "direction"
        ],
        "title": "ActivityOut",
        "type": "object"
      },
      "DealIn": {
        "description": "Create a deal. `value_minor` is integer minor units of `currency` (ISO-4217) \u2014 no\nfloat, ever. `owner_id` is optional: omitted, the deal belongs to the calling rep;\nnaming another rep is an object-level scope question the route answers. `probability`\nomitted takes the stage's board default. `last_activity_at` is the server's staleness\nclock and `organization_id` comes from the tenant context, so neither is accepted.",
        "properties": {
          "close_date": {
            "format": "date",
            "title": "Close Date",
            "type": "string"
          },
          "company_id": {
            "format": "uuid",
            "title": "Company Id",
            "type": "string"
          },
          "currency": {
            "default": "INR",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "primary_contact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Contact Id"
          },
          "probability": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability"
          },
          "source": {
            "default": "",
            "maxLength": 60,
            "title": "Source",
            "type": "string"
          },
          "stage": {
            "default": "lead",
            "enum": [
              "lead",
              "qualified",
              "proposal",
              "negotiation",
              "closed_won",
              "closed_lost"
            ],
            "title": "Stage",
            "type": "string"
          },
          "value_minor": {
            "minimum": 0.0,
            "title": "Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "company_id",
          "value_minor",
          "close_date"
        ],
        "title": "DealIn",
        "type": "object"
      },
      "DealOut": {
        "description": "Mirrors the SPA's `Deal`. `value_minor` is minor units of `currency`; `probability`\nis 0-100; a past `close_date` on an open deal reads as overdue; `last_activity_at` is\nthe staleness clock (NULL: never touched).",
        "properties": {
          "close_date": {
            "format": "date",
            "title": "Close Date",
            "type": "string"
          },
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_activity_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Activity At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "primary_contact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Contact Id"
          },
          "probability": {
            "title": "Probability",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "stage": {
            "enum": [
              "lead",
              "qualified",
              "proposal",
              "negotiation",
              "closed_won",
              "closed_lost"
            ],
            "title": "Stage",
            "type": "string"
          },
          "value_minor": {
            "title": "Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "company_id",
          "primary_contact_id",
          "value_minor",
          "currency",
          "stage",
          "owner_id",
          "probability",
          "close_date",
          "created_at",
          "last_activity_at",
          "source"
        ],
        "title": "DealOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Page_ActivityOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ActivityOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size",
          "pages"
        ],
        "title": "Page[ActivityOut]",
        "type": "object"
      },
      "Page_DealOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DealOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size",
          "pages"
        ],
        "title": "Page[DealOut]",
        "type": "object"
      },
      "ServiceInfo": {
        "properties": {
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "schema_name"
        ],
        "title": "ServiceInfo",
        "type": "object"
      },
      "StageIn": {
        "description": "Move a deal to another stage. A transition, not a field edit: which moves are legal\nis `domain.can_transition`, enforced by the service. `probability` omitted takes the\nnew stage's default \u2014 100 once won, 0 once lost.",
        "properties": {
          "probability": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability"
          },
          "stage": {
            "enum": [
              "lead",
              "qualified",
              "proposal",
              "negotiation",
              "closed_won",
              "closed_lost"
            ],
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "stage"
        ],
        "title": "StageIn",
        "type": "object"
      },
      "StageRollupOut": {
        "description": "One column of the pipeline funnel \u2014 count and summed open value per stage, with\n`pct` scaled to the richest stage so the bars read as a funnel. Mirrors the SPA's\n`StageRollup` (and its `stageFunnel` arithmetic in `data/derive.ts`).",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "pct": {
            "title": "Pct",
            "type": "integer"
          },
          "stage": {
            "enum": [
              "lead",
              "qualified",
              "proposal",
              "negotiation",
              "closed_won",
              "closed_lost"
            ],
            "title": "Stage",
            "type": "string"
          },
          "value_minor": {
            "title": "Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "stage",
          "label",
          "count",
          "value_minor",
          "pct"
        ],
        "title": "StageRollupOut",
        "type": "object"
      },
      "SummaryOut": {
        "description": "The Overview dashboard's server-side rollup: the same arithmetic the SPA's\n`data/derive.ts` runs over the deal list, exposed once so a reporting view can share\nit. Headline figures are computed live from the deals and activities; the trend's\nearlier months are representative history (the seam a reporting service replaces \u2014\nsee `app.domain.pipeline_trend`), with the final point always the live open pipeline.",
        "properties": {
          "activities_this_week": {
            "title": "Activities This Week",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "funnel": {
            "items": {
              "$ref": "#/components/schemas/StageRollupOut"
            },
            "title": "Funnel",
            "type": "array"
          },
          "open_deals": {
            "title": "Open Deals",
            "type": "integer"
          },
          "pipeline_value_minor": {
            "title": "Pipeline Value Minor",
            "type": "integer"
          },
          "trend": {
            "items": {
              "$ref": "#/components/schemas/TrendPointOut"
            },
            "title": "Trend",
            "type": "array"
          },
          "weighted_pipeline_minor": {
            "title": "Weighted Pipeline Minor",
            "type": "integer"
          },
          "win_rate_pct": {
            "title": "Win Rate Pct",
            "type": "integer"
          },
          "won_value_minor": {
            "title": "Won Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "pipeline_value_minor",
          "weighted_pipeline_minor",
          "open_deals",
          "win_rate_pct",
          "won_value_minor",
          "activities_this_week",
          "currency"
        ],
        "title": "SummaryOut",
        "type": "object"
      },
      "TrendPointOut": {
        "description": "A point on the pipeline-value-over-time chart. Mirrors the SPA's `TrendPoint`.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "value_minor": {
            "title": "Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "label",
          "value_minor"
        ],
        "title": "TrendPointOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Deal service \u2014 part of the OpsGrids platform.",
    "title": "Deal service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/deal/info": {
      "get": {
        "operationId": "info_api_v1_deal_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this service is",
        "tags": [
          "deal"
        ]
      }
    },
    "/api/v1/deals": {
      "get": {
        "operationId": "list_deals_api_v1_deals_get",
        "parameters": [
          {
            "description": "Deal name",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Deal name",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "stage",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stage"
            }
          },
          {
            "in": "query",
            "name": "owner_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Owner Id"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_DealOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deals in the pipeline",
        "tags": [
          "deal"
        ]
      },
      "post": {
        "description": "`request` is passed through because the audit row records the actor and the origin\nof the call, not merely that a deal appeared.",
        "operationId": "create_deal_api_v1_deals_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DealIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create a deal",
        "tags": [
          "deal"
        ]
      }
    },
