    "/api/v1/deals/summary": {
      "get": {
        "description": "The same arithmetic the SPA's `data/derive.ts` runs over the deal list, computed\nserver-side over the caller's scope: an OWN-scoped rep gets their own numbers.\n\n`owner_id`/`owner=me` narrow *further*, the way `/deals`'s own `owner_id` filter does \u2014 both\ncompose with `ctx.apply`'s scope filter rather than replacing it, so an OWN-scoped caller who\nnames someone else's id still gets nothing back, never that colleague's numbers. `owner=me`\nresolves the caller's own id from the token (`ctx.subject_ref`) rather than trusting a\ncaller-chosen id for \"mine\"; a caller with no `subject_ref` gets the all-zero rollup, never\nthe whole book.",
        "operationId": "summary_api_v1_deals_summary_get",
        "parameters": [
          {
            "description": "Narrow the rollup to one rep's own pipeline",
            "in": "query",
            "name": "owner_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Narrow the rollup to one rep's own pipeline",
              "title": "Owner Id"
            }
          },
          {
            "description": "`me` narrows to the caller's own pipeline, resolved server-side",
            "in": "query",
            "name": "owner",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "const": "me",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`me` narrows to the caller's own pipeline, resolved server-side",
              "title": "Owner"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pipeline summary \u2014 the Overview rollups",
        "tags": [
          "deal"
        ]
      }
    },
