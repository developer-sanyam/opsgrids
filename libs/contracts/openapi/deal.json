{
  "components": {
    "schemas": {
      "ActivityIn": {
        "additionalProperties": false,
        "description": "Log one entry on the timeline. Append-only: there is no matching `Patch` \u2014 a wrong\nentry is corrected by logging a new one, not by editing this one.\n\nAt least one of `deal_id` / `company_id` / `contact_id` must be given \u2014 an activity\nnaming nothing is not a timeline entry. `direction` only means something for a call or\nan email; naming it on a meeting, note or task is refused. `occurred_at` defaults to\nnow and may backfill the past, but never the future \u2014 a touch cannot be logged before\nit happens. A value with no UTC offset is read as UTC, not as the caller's local time, so\na client outside UTC must send its offset: a past wall clock sent without one is stored\nas UTC, wrong by that client's offset.\n\n`owner_id` is optional: an ORG-scoped caller may attribute the entry to another rep, while\nan OWN-scoped caller can only ever log against themselves and the route forces it, whatever\nthe body says \u2014 see `app/api/routes.py`.",
        "properties": {
          "body": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          },
          "company_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Id"
          },
          "contact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id"
          },
          "deal_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deal Id"
          },
          "direction": {
            "anyOf": [
              {
                "enum": [
                  "inbound",
                  "outbound"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "occurred_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "RFC 3339 instant. A value with no UTC offset is read as UTC, so send an offset such as 2026-09-02T14:45:00+05:30 or 2026-09-02T09:15:00Z.",
            "title": "Occurred At"
          },
          "owner_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "subject": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "type": {
            "enum": [
              "call",
              "email",
              "meeting",
              "note",
              "task"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "subject"
        ],
        "title": "ActivityIn",
        "type": "object"
      },
      "ActivityOut": {
        "description": "Mirrors the SPA's `Activity`. `type` is the wire name for the touch kind; exactly\none of the target ids is usually set, and the owner always is.",
        "properties": {
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          },
          "company_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Id"
          },
          "contact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Id"
          },
          "deal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deal Id"
          },
          "direction": {
            "anyOf": [
              {
                "enum": [
                  "inbound",
                  "outbound"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "type": {
            "enum": [
              "call",
              "email",
              "meeting",
              "note",
              "task"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "subject",
          "body",
          "deal_id",
          "company_id",
          "contact_id",
          "owner_id",
          "occurred_at",
          "direction"
        ],
        "title": "ActivityOut",
        "type": "object"
      },
      "DealIn": {
        "additionalProperties": false,
        "description": "Open an opportunity. `company_id` / `primary_contact_id` / `owner_id` are plain\nUUIDs into customer-service's schema \u2014 deal-service cannot verify they resolve there\n(no cross-schema FK, no cross-schema query), so none of the three is checked here.\n\n`owner_id` is optional: an omitted one defaults to the calling rep, matching how\nactivities attribute themselves. Naming a different rep is an ORG-scoped act \u2014 the\nroute re-applies the caller's scope exactly as it does on a detail route \u2014 and a\ncaller with no rep identity who also names no owner has nobody to attribute the deal\nto, which is a 422, not a row owned by nothing.",
        "properties": {
          "close_date": {
            "format": "date",
            "title": "Close Date",
            "type": "string"
          },
          "company_id": {
            "format": "uuid",
            "title": "Company Id",
            "type": "string"
          },
          "currency": {
            "default": "INR",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "primary_contact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Contact Id"
          },
          "probability": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability"
          },
          "source": {
            "default": "",
            "maxLength": 60,
            "title": "Source",
            "type": "string"
          },
          "stage": {
            "default": "lead",
            "enum": [
              "lead",
              "qualified",
              "proposal",
              "negotiation",
              "closed_won",
              "closed_lost"
            ],
            "title": "Stage",
            "type": "string"
          },
          "value_minor": {
            "minimum": 0.0,
            "title": "Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "company_id",
          "value_minor",
          "close_date"
        ],
        "title": "DealIn",
        "type": "object"
      },
      "DealOut": {
        "description": "Mirrors the SPA's `Deal`. `value_minor` is minor units of `currency`; `probability`\nis 0-100; a past `close_date` on an open deal reads as overdue; `last_activity_at` is\nthe staleness clock (NULL: never touched).",
        "properties": {
          "close_date": {
            "format": "date",
            "title": "Close Date",
            "type": "string"
          },
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_activity_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Activity At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "primary_contact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Contact Id"
          },
          "probability": {
            "title": "Probability",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "stage": {
            "enum": [
              "lead",
              "qualified",
              "proposal",
              "negotiation",
              "closed_won",
              "closed_lost"
            ],
            "title": "Stage",
            "type": "string"
          },
          "value_minor": {
            "title": "Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "company_id",
          "primary_contact_id",
          "value_minor",
          "currency",
          "stage",
          "owner_id",
          "probability",
          "close_date",
          "created_at",
          "last_activity_at",
          "source"
        ],
        "title": "DealOut",
        "type": "object"
      },
      "DealPatch": {
        "additionalProperties": false,
        "description": "Partial update of the plain deal fields. Deliberately **no `stage`** \u2014 a stage\nmove only ever goes through `POST /deals/{id}/stage`, so the transition rule and its\nevent can never be bypassed by a patch. Reassigning `owner_id` is scope-checked in\n`app.services.update_deal` exactly like naming one on create \u2014 an OWN-scoped caller\nmay only set it to themselves.",
        "properties": {
          "close_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close Date"
          },
          "company_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Id"
          },
          "currency": {
            "anyOf": [
              {
                "maxLength": 3,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "owner_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Id"
          },
          "primary_contact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Contact Id"
          },
          "probability": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "value_minor": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Minor"
          }
        },
        "title": "DealPatch",
        "type": "object"
      },
