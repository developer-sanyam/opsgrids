      "StageMoveIn": {
        "additionalProperties": false,
        "description": "Move a deal through the pipeline. `domain.can_transition` is the enforcement\npoint \u2014 an illegal move (out of a closed stage, or to the same stage) answers 409.",
        "properties": {
          "probability": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability"
          },
          "stage": {
            "enum": [
              "lead",
              "qualified",
              "proposal",
              "negotiation",
              "closed_won",
              "closed_lost"
            ],
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "stage"
        ],
        "title": "StageMoveIn",
        "type": "object"
      },
      "StageRollupOut": {
        "description": "One column of the pipeline funnel \u2014 count and summed open value per stage, with\n`pct` scaled to the richest stage so the bars read as a funnel. Mirrors the SPA's\n`StageRollup` (and its `stageFunnel` arithmetic in `data/derive.ts`).",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "pct": {
            "title": "Pct",
            "type": "integer"
          },
          "stage": {
            "enum": [
              "lead",
              "qualified",
              "proposal",
              "negotiation",
              "closed_won",
              "closed_lost"
            ],
            "title": "Stage",
            "type": "string"
          },
          "value_minor": {
            "title": "Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "stage",
          "label",
          "count",
          "value_minor",
          "pct"
        ],
        "title": "StageRollupOut",
        "type": "object"
      },
      "SummaryOut": {
        "description": "The Overview dashboard's server-side rollup: the same arithmetic the SPA's\n`data/derive.ts` runs over the deal list, exposed once so a reporting view can share\nit. Headline figures are computed live from the deals and activities.\n\n`trend` is `None`, not a placeholder history: an open-pipeline-value-over-time chart needs a\ndated snapshot of what was open on a past day, and this service keeps only each deal's\n*current* stage and value, never a history of either. That is a genuinely missing capability\n(a stage-history/insights projection, dashboard-data audit \u00a73.3 row 12), not something this\nendpoint can compute honestly today \u2014 so it reports `None` here instead of the fixed months\nit used to serve unflagged as if they were real.",
        "properties": {
          "activities_this_week": {
            "title": "Activities This Week",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "funnel": {
            "items": {
              "$ref": "#/components/schemas/StageRollupOut"
            },
            "title": "Funnel",
            "type": "array"
          },
          "open_deals": {
            "title": "Open Deals",
            "type": "integer"
          },
          "pipeline_value_minor": {
            "title": "Pipeline Value Minor",
            "type": "integer"
          },
          "trend": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TrendPointOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trend"
          },
          "weighted_pipeline_minor": {
            "title": "Weighted Pipeline Minor",
            "type": "integer"
          },
          "win_rate_pct": {
            "title": "Win Rate Pct",
            "type": "integer"
          },
          "won_value_minor": {
            "title": "Won Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "pipeline_value_minor",
          "weighted_pipeline_minor",
          "open_deals",
          "win_rate_pct",
          "won_value_minor",
          "activities_this_week",
          "currency"
        ],
        "title": "SummaryOut",
        "type": "object"
      },
      "TrendPointOut": {
        "description": "A point on the pipeline-value-over-time chart. Mirrors the SPA's `TrendPoint`.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "value_minor": {
            "title": "Value Minor",
            "type": "integer"
          }
        },
        "required": [
          "label",
          "value_minor"
        ],
        "title": "TrendPointOut",
        "type": "object"
      },
