    "/api/v1/deals/summary": {
      "get": {
        "description": "The same arithmetic the SPA's `data/derive.ts` runs over the deal list, computed\nserver-side over the caller's scope: an OWN-scoped rep gets their own numbers.",
        "operationId": "summary_api_v1_deals_summary_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Pipeline summary \u2014 the Overview rollups",
        "tags": [
          "deal"
        ]
      }
    },
    "/api/v1/deals/{deal_id}": {
      "get": {
        "operationId": "read_deal_api_v1_deals__deal_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "deal_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Deal Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
