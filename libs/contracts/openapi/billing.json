    "/api/v1/credit-balance": {
      "get": {
        "description": "Balance is derived, never stored: a `SUM` over the ledger rows whose validity window\ncovers this instant. A lapsed grant is already gone from it, with nothing having run.",
        "operationId": "credit_balance_api_v1_credit_balance_get",
        "parameters": [
          {
            "description": "ISO-4217 code",
            "in": "query",
            "name": "currency",
            "required": true,
            "schema": {
              "description": "ISO-4217 code",
              "maxLength": 3,
              "minLength": 3,
              "title": "Currency",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditBalanceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Credit available now \u2014 the windowed SUM over the ledger (ADR-0004 \u00a73)",
        "tags": [
          "billing"
        ]
      }
    },
    "/api/v1/invoices": {
