  "info": {
    "description": "The financial record of truth: append-only invoices frozen at finalize, and an append-only credit ledger whose balance is a windowed SUM, never a stored column. All money is integer minor units \u2014 no floats anywhere in billing.",
    "title": "Billing service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/credit-ledger": {
      "get": {
        "operationId": "admin_list_credit_ledger_api_v1_admin_credit_ledger_get",
        "parameters": [
          {
            "in": "query",
            "name": "organization_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Organization Id"
            }
          },
          {
            "in": "query",
            "name": "currency",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 3,
                  "minLength": 3,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Currency"
            }
          },
          {
            "in": "query",
            "name": "entry_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entry Type"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_CreditLedgerEntryAdminOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The credit ledger across every organization, filtered and paginated",
        "tags": [
          "billing-admin"
        ]
      }
    },
    "/api/v1/admin/invoices": {
      "get": {
        "description": "Same gate, session and pagination as `/credit-ledger`; the difference is that the\norganization is **required** \u2014 there is no useful platform-wide invoice overview here, and a\nper-org read is what the account detail screen needs. Every call is audited (see\n`services.record_operator_invoices_read`). Read-only: nothing on this router writes an\ninvoice, and the directory role could not if it tried (SELECT only).",
        "operationId": "admin_list_invoices_api_v1_admin_invoices_get",
        "parameters": [
          {
            "in": "query",
            "name": "organization_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Organization Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_InvoiceAdminOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One organization's OpsGrids invoices \u2014 read-only, for the staff Billing tab",
        "tags": [
          "billing-admin"
        ]
      }
    },
    "/api/v1/audit/billing": {
      "get": {
        "operationId": "list_audit_log_api_v1_audit_billing_get",
        "parameters": [
          {
            "description": "Inclusive lower bound on `at`",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive lower bound on `at`",
              "title": "From"
            }
          },
          {
            "description": "Exclusive upper bound on `at`",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive upper bound on `at`",
              "title": "To"
            }
          },
          {
            "description": "The user who acted",
            "in": "query",
            "name": "actor_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The user who acted",
              "title": "Actor Id"
            }
          },
          {
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          },
          {
            "in": "query",
            "name": "entity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Missing core.identity.audit.read at ORG scope"
          },
          "422": {
            "description": "A bad cursor, filter or date range"
          }
        },
        "summary": "The organization's audit trail recorded by this service, newest first",
        "tags": [
          "audit"
        ]
      }
    },
    "/api/v1/billing/info": {
      "get": {
        "operationId": "info_api_v1_billing_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this service is",
        "tags": [
          "billing"
        ]
      }
    },
    "/api/v1/credit-balance": {
      "get": {
        "description": "Balance is derived, never stored: a `SUM` over the ledger rows whose validity window\ncovers this instant. A lapsed grant is already gone from it, with nothing having run.",
        "operationId": "credit_balance_api_v1_credit_balance_get",
        "parameters": [
          {
            "description": "ISO-4217 code",
            "in": "query",
            "name": "currency",
            "required": true,
            "schema": {
              "description": "ISO-4217 code",
              "maxLength": 3,
              "minLength": 3,
              "title": "Currency",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditBalanceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Credit available now \u2014 the windowed SUM over the ledger (ADR-0004 \u00a73)",
        "tags": [
          "billing"
        ]
      }
    },
    "/api/v1/invoices": {
      "get": {
        "operationId": "list_invoices_api_v1_invoices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
