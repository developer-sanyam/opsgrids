      "TimesheetRowOut": {
        "description": "A person's timesheet for one week: seven daily cells and an approval state. Mirrors the\nSPA's `TimesheetRow`; `person_id` is the person's stable `ref` (`p01`). `entries` is the\nper-slot detail the cells are summed from \u2014 the grid's compact view loses it, so an edit\nthat only touches one day needs it to resend the rest unchanged.",
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/TimesheetCellOut"
            },
            "title": "Cells",
            "type": "array"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/TimesheetEntryOut"
            },
            "title": "Entries",
            "type": "array"
          },
          "person_id": {
            "title": "Person Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "submitted",
              "approved"
            ],
            "title": "Status",
            "type": "string"
