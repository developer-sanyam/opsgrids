          "week_start": {
            "format": "date",
            "title": "Week Start",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "week_start",
          "status",
          "cells",
          "entries"
        ],
        "title": "TimesheetRowOut",
        "type": "object"
      },
      "TimesheetStatusIn": {
