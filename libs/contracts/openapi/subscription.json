{
  "components": {
    "schemas": {
      "CancelIn": {
        "description": "Cancel a subscription. Immediate for the MVP; `reason` is recorded on the transition.",
        "properties": {
          "reason": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "title": "CancelIn",
        "type": "object"
      },
      "ChangePlanIn": {
        "description": "Re-pin a subscription to a different published version. The old pin is preserved on the\ntransition row \u2014 never overwritten in history (ADR-0004 \u00a72).",
        "properties": {
          "plan_version_id": {
            "format": "uuid",
            "title": "Plan Version Id",
            "type": "string"
          }
        },
        "required": [
          "plan_version_id"
        ],
        "title": "ChangePlanIn",
        "type": "object"
      },
      "DunningOut": {
        "description": "The live grace window, as the customer's own app should render it (ADR-0005).\n\nPresent only while a cycle is open, which is exactly while the subscription is `past_due` or\n`suspended` for non-payment. It carries the two dates a banner has to be able to say out loud\n\u2014 when the next debit will be attempted, and when access stops \u2014 read from the stored\nschedule rather than recomputed, so the screen and the sweep can never disagree.",
        "properties": {
          "amount_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Minor"
          },
          "attempts_made": {
            "title": "Attempts Made",
            "type": "integer"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "cycle_id": {
            "format": "uuid",
            "title": "Cycle Id",
            "type": "string"
          },
          "grace_ends_at": {
            "format": "date-time",
            "title": "Grace Ends At",
            "type": "string"
          },
          "max_attempts": {
            "title": "Max Attempts",
            "type": "integer"
          },
          "next_attempt_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Attempt At"
          },
          "opened_at": {
            "format": "date-time",
            "title": "Opened At",
            "type": "string"
          }
        },
        "required": [
          "cycle_id",
          "opened_at",
          "grace_ends_at",
          "attempts_made",
          "max_attempts"
        ],
        "title": "DunningOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ServiceInfo": {
        "properties": {
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "schema_name"
        ],
        "title": "ServiceInfo",
        "type": "object"
      },
      "SubscribeIn": {
        "description": "Start a subscription for a product, pinned to a catalog plan version.\n\n`trial_days` set starts the subscription in `trial` with an end date; left null it starts\n`active`. A trial is a *state of the subscription*, never a separate object (ADR-0004 \u00a74).",
        "properties": {
          "plan_version_id": {
            "format": "uuid",
            "title": "Plan Version Id",
            "type": "string"
          },
          "product_key": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Product Key",
            "type": "string"
          },
          "trial_days": {
            "anyOf": [
              {
                "maximum": 365.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Days"
          }
        },
        "required": [
          "product_key",
          "plan_version_id"
        ],
        "title": "SubscribeIn",
        "type": "object"
      },
      "SubscriptionItemOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "price_id": {
            "format": "uuid",
            "title": "Price Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "price_id",
          "quantity"
        ],
        "title": "SubscriptionItemOut",
        "type": "object"
      },
      "SubscriptionOut": {
        "properties": {
          "cancel_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancel At"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "current_period_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Period End"
          },
          "current_period_start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Period Start"
          },
          "dunning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DunningOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SubscriptionItemOut"
            },
            "title": "Items",
            "type": "array"
          },
          "plan_version_id": {
            "format": "uuid",
            "title": "Plan Version Id",
            "type": "string"
          },
          "product_key": {
            "title": "Product Key",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "trial_ends_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Ends At"
          }
        },
        "required": [
          "id",
          "product_key",
          "plan_version_id",
          "state",
          "currency"
        ],
        "title": "SubscriptionOut",
        "type": "object"
      },
      "ValidationError": {
