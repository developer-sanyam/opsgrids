{
  "components": {
    "schemas": {
      "CancelIn": {
        "description": "Cancel a subscription. Immediate and terminal: access ends now, and a cancelled\nsubscription cannot be reopened or replaced (one row per product per organization). `reason`\nis the customer's own words, recorded as the audit row's reason.",
        "properties": {
          "reason": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "title": "CancelIn",
        "type": "object"
      },
      "ChangePlanIn": {
        "description": "Re-pin a subscription to a different published version. The old pin is preserved on the\ntransition row \u2014 never overwritten in history (ADR-0004 \u00a72).\n\nThe version must be one catalog offers this organization now (422 `not_offerable` otherwise),\nor the pin the subscription is already on \u2014 which withdraws a change that is waiting.\n`expected` is the state the customer's preview was computed from (`CustomerChangePlanPreviewOut.\nexpected`, sent back whole); when sent, it is compared under the row lock \u2014 state, pin, pending\nchange, period end and the billing run's pending claim \u2014 and a mismatch is a 409\n`state_changed`, so a confirm never applies a change, a date or a charge the customer did not\nsee. Optional, so a caller that predates the preview keeps working.\n\nA change the OpsGrids team scheduled (a negotiated price from the next period) is not the\ncustomer's to withdraw or replace: while one waits, every customer change is refused 422\n`scheduled_by_opsgrids`.",
        "properties": {
          "expected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CustomerExpectedState"
              },
              {
                "type": "null"
              }
            ]
          },
          "plan_version_id": {
            "format": "uuid",
            "title": "Plan Version Id",
            "type": "string"
          }
        },
        "required": [
          "plan_version_id"
        ],
        "title": "ChangePlanIn",
        "type": "object"
      },
      "ChangePlanPreviewIn": {
        "additionalProperties": false,
        "description": "The customer's question behind the Change plan confirm: *what would this change do?*\nRead-only, and answered by the same evaluation the write runs.",
        "properties": {
          "plan_version_id": {
            "format": "uuid",
            "title": "Plan Version Id",
            "type": "string"
          }
        },
        "required": [
          "plan_version_id"
        ],
        "title": "ChangePlanPreviewIn",
        "type": "object"
      },
      "CustomerChangePlanPreviewOut": {
        "description": "The customer's preview: the same answer, with the customer's fuller `expected` to send back.\n\n`direction` is null whenever `paid` is false (a trial with nothing claimed): such a change is\nalways now and free, so the comparison is never needed, and answering it would let a trialist\ncompare any public plan's list price against a negotiated amount they can see.",
        "properties": {
          "action": {
            "default": "switch",
            "enum": [
              "switch",
              "withdraw_scheduled"
            ],
            "title": "Action",
            "type": "string"
          },
          "direction": {
            "anyOf": [
              {
                "enum": [
                  "upgrade",
                  "downgrade",
                  "equal"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "effective": {
            "anyOf": [
              {
                "enum": [
                  "now",
                  "next_period"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective"
          },
          "effective_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective At"
          },
          "entitled_added": {
            "items": {
              "type": "string"
            },
            "title": "Entitled Added",
            "type": "array"
          },
          "entitled_removed": {
            "items": {
              "type": "string"
            },
            "title": "Entitled Removed",
            "type": "array"
          },
          "expected": {
            "$ref": "#/components/schemas/CustomerExpectedState"
          },
          "paid": {
            "default": false,
            "title": "Paid",
            "type": "boolean"
          },
          "prorated_charge_now": {
            "default": false,
            "title": "Prorated Charge Now",
            "type": "boolean"
          },
          "refusal_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refusal Code"
          },
          "refusal_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refusal Detail"
          },
          "usage_closed_now": {
            "default": false,
            "title": "Usage Closed Now",
            "type": "boolean"
          },
          "usage_priced": {
            "default": false,
            "title": "Usage Priced",
            "type": "boolean"
          },
          "would_clear_pending": {
            "default": false,
            "title": "Would Clear Pending",
            "type": "boolean"
          }
        },
        "required": [
          "expected"
        ],
        "title": "CustomerChangePlanPreviewOut",
        "type": "object"
      },
      "CustomerExpectedState": {
        "additionalProperties": false,
        "description": "The customer's picture of the subscription: `ExpectedState` plus the two facts that decide\n*when* a change lands and *whether money moves*, neither of which state, pin or pending\ncaptures.\n\n* `current_period_end` \u2014 a scheduled change lands at the end of the period (or of the claimed\n  one). A renewal the billing run records moves this and nothing else, so without it a preview\n  that said \"moves on 5 Nov\" would be confirmed after the roll and scheduled for 5 Dec.\n* `lifecycle_claim_id` \u2014 the renewal or trial conversion the billing run has claimed and not yet\n  recorded, or null. A claim prices the change against the claimed period, and a claimed trial\n  conversion turns a free trial switch into a paid, prorated one while `state` still says\n  `trial`.\n\nBoth are required, null included: the customer confirm sends back exactly what its preview\nreturned, so a missing field is a client that never saw a preview, not an old caller to excuse.\nThe staff path keeps `ExpectedState` \u2014 console builds it from the three fields it reads.",
        "properties": {
          "current_period_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Period End"
          },
          "lifecycle_claim_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lifecycle Claim Id"
          },
          "pending_plan_version_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending Plan Version Id"
          },
          "plan_version_id": {
            "format": "uuid",
            "title": "Plan Version Id",
            "type": "string"
          },
          "state": {
            "maxLength": 20,
            "minLength": 1,
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "plan_version_id",
          "current_period_end",
          "lifecycle_claim_id"
        ],
        "title": "CustomerExpectedState",
        "type": "object"
      },
      "DunningOut": {
        "description": "The live grace window, as the customer's own app should render it (ADR-0005).\n\nPresent only while a cycle is open, which is exactly while the subscription is `past_due` or\n`suspended` for non-payment. It carries the two dates a banner has to be able to say out loud\n\u2014 when the next debit will be attempted, and when access stops \u2014 read from the stored\nschedule rather than recomputed, so the screen and the sweep can never disagree.",
        "properties": {
          "amount_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Minor"
          },
          "attempts_made": {
            "title": "Attempts Made",
            "type": "integer"
          },
          "currency": {
            "anyOf": [
