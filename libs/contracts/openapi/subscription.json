  "info": {
    "description": "The per-customer commercial lifecycle: trial \u2192 active \u2192 renew/upgrade/downgrade \u2192 past_due/suspended/cancelled. The state machine where entitlement is decided; every transition emits a commerce.subscription.* event that product-service projects onto the activation the 402 gate reads.",
    "title": "Subscription service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/subscription/info": {
      "get": {
        "operationId": "info_api_v1_subscription_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this service is",
        "tags": [
          "subscription"
        ]
      }
    },
    "/api/v1/subscriptions": {
