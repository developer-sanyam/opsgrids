                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "cycle_id": {
            "format": "uuid",
            "title": "Cycle Id",
            "type": "string"
          },
          "grace_ends_at": {
            "format": "date-time",
            "title": "Grace Ends At",
            "type": "string"
          },
          "max_attempts": {
            "title": "Max Attempts",
            "type": "integer"
          },
          "next_attempt_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
