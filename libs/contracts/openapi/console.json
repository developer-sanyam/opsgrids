                "schema": {
                  "$ref": "#/components/schemas/AuditListOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Recent operator-override audit rows across every organization",
        "tags": [
          "console"
        ]
      }
    },
