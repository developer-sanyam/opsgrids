  "info": {
    "description": "The operator console's read model of commerce: it folds the commerce transition-event stream (subscription, invoice, credit, usage) into cross-tenant projections and serves the staff read API on the admin gateway \u2014 MRR, trial-conversion, churn, per-org state \u2014 with overrides that delegate to the owning service. Never writes another service's schema.",
    "title": "Operator console service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/audit": {
      "get": {
        "operationId": "list_audit_api_v1_admin_audit_get",
        "responses": {
          "200": {
            "content": {
