      "EmployeePiiIn": {
        "description": "Sensitive PII supplied as **plaintext**. Every field optional: on create it is what is\nknown; on patch, present means \"seal this new value\", absent means \"leave it alone\".\n\nThe service seals each provided value before it touches the database \u2014 the plaintext lives\nonly for the length of that call and is never stored, logged, audited or put in an event.",
        "properties": {
          "aadhaar": {
            "anyOf": [
              {
                "maxLength": 12,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aadhaar"
          },
          "bank_account": {
            "anyOf": [
              {
                "maxLength": 18,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bank Account"
          },
          "bank_ifsc": {
            "anyOf": [
              {
                "maxLength": 11,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bank Ifsc"
          },
          "date_of_birth": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Of Birth"
          },
          "esi": {
            "anyOf": [
              {
                "maxLength": 17,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Esi"
          },
          "pan": {
            "anyOf": [
              {
                "maxLength": 10,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pan"
          },
          "personal_email": {
            "anyOf": [
              {
                "maxLength": 254,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Personal Email"
          },
          "personal_phone": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Personal Phone"
          },
          "uan": {
            "anyOf": [
              {
                "maxLength": 12,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uan"
          }
        },
        "title": "EmployeePiiIn",
        "type": "object"
      },
      "EmployeePiiMasked": {
        "description": "The safe projection of an employee's PII: masks only, plus the whole IFSC.\n\nThis is the default read shape. Every value here is either a non-sensitive hint\n(`\u2022\u2022\u2022\u2022 \u2022\u2022\u2022\u2022 3210`) or a field classified non-sensitive (`bank_ifsc`). It is built from the\nstored `_masked` columns, so producing it never decrypts anything.",
        "properties": {
          "aadhaar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aadhaar"
