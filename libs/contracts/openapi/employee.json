          "date_of_joining": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Of Joining"
          },
          "department_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
