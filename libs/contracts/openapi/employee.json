  "paths": {
    "/api/v1/employees": {
      "get": {
        "operationId": "list_employees_api_v1_employees_get",
        "parameters": [
          {
            "description": "Name, number or designation",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
