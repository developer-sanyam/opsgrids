              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dotted Line Manager Id"
          },
          "employee_no": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Employee No",
            "type": "string"
          },
          "employment_type": {
            "default": "full_time",
            "enum": [
              "full_time",
              "part_time",
              "contract",
              "intern"
            ],
            "title": "Employment Type",
            "type": "string"
          },
          "full_name": {
            "maxLength": 200,
            "minLength": 1,
