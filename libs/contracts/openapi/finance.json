      "EInvoiceState": {
        "description": "An invoice's *current* e-invoice position, derived from its newest filing row.\n\nCarried on the invoice read model so a screen never has to fetch the history to know whether\na document is registered. `required` is the statutory question (B2B, export and SEZ documents\nneed an IRN; B2C does not), and it is answered even when nothing has been attempted \u2014 that is\nwhat makes an un-filed obligation visible instead of silent.",
        "properties": {
          "ack_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ack Date"
          },
          "ack_no": {
            "anyOf": [
