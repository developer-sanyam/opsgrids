      "InvoiceLineOut": {
        "description": "One line on an invoice. `amount_minor` foots to `quantity x unit_price_minor`, and is the\n**taxable value** the line's GST is computed on.\n\nExactly one tax shape is populated: `cgst_minor` + `sgst_minor` on an intra-state supply,\n`igst_minor` on an inter-state one. The three always sum to the tax actually charged.",
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "cgst_minor": {
            "default": 0,
            "title": "Cgst Minor",
            "type": "integer"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "hsn_sac": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hsn Sac"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "igst_minor": {
            "default": 0,
            "title": "Igst Minor",
            "type": "integer"
          },
          "quantity": {
            "title": "Quantity",
            "type": "number"
          },
          "sgst_minor": {
            "default": 0,
            "title": "Sgst Minor",
            "type": "integer"
          },
          "tax_rate_pct": {
            "default": 0,
            "title": "Tax Rate Pct",
            "type": "number"
          },
          "unit_price_minor": {
            "title": "Unit Price Minor",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "description",
          "quantity",
          "unit_price_minor",
          "amount_minor"
        ],
        "title": "InvoiceLineOut",
        "type": "object"
      },
      "InvoiceOut": {
