  "info": {
    "description": "Finance service \u2014 part of the Atmora platform.",
    "title": "Finance service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/finance/customers": {
      "get": {
        "operationId": "list_customers_api_v1_finance_customers_get",
        "parameters": [
          {
            "description": "Customer name or city",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Customer name or city",
              "title": "Q"
            }
          },
          {
            "description": "receivables_desc|overdue_desc|name_asc",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "receivables_desc",
              "description": "receivables_desc|overdue_desc|name_asc",
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_CustomerSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Customers and their receivable positions",
        "tags": [
          "finance"
        ]
      }
    },
    "/api/v1/finance/info": {
      "get": {
        "operationId": "info_api_v1_finance_info_get",
