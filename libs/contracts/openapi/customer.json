          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Customer service \u2014 part of the OpsGrids platform.",
    "title": "Customer service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/contacts": {
      "get": {
        "operationId": "list_contacts_api_v1_contacts_get",
        "parameters": [
          {
            "description": "Name, title or email",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Name, title or email",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_ContactOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Contacts across the account book",
        "tags": [
          "customer"
        ]
      },
      "post": {
        "description": "Create a contact through the service writer \u2014 audit row and `contact.created` event\nstaged in the same transaction as the insert.\n\nScope is checked against the owner the payload names, as on a company. The company itself\nis validated inside the service: a company belonging to another organization reads as\nnot-found, never as a constraint error, so an id cannot be probed for existence.\n\nA supplied `raw_phone` is sealed and its mask derived. The response is the ordinary masked\n`ContactOut`, so creating a contact is not a way to read a number back \u2014 the only route\nthat returns one is the stepped-up, audited reveal below.",
        "operationId": "create_contact_api_v1_contacts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add a person to an account",
        "tags": [
          "customer"
        ]
      }
    },
    "/api/v1/contacts/{contact_id}": {
      "get": {
        "operationId": "read_contact_api_v1_contacts__contact_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "contact_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Contact Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One contact",
        "tags": [
          "customer"
        ]
      }
    },
    "/api/v1/contacts/{contact_id}/phone": {
      "put": {
        "description": "Seal a real number onto a contact and derive its mask.\n\nReturns the ordinary `ContactOut` \u2014 the masked form \u2014 so the write surface cannot be used\nas a read-back oracle for the number just supplied. Revealing it needs the separate\nstepped-up route below.",
        "operationId": "set_contact_phone_api_v1_contacts__contact_id__phone_put",
        "parameters": [
          {
            "in": "path",
            "name": "contact_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Contact Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactPhoneIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set a contact's real phone number",
        "tags": [
          "customer"
        ]
      }
    },
    "/api/v1/contacts/{contact_id}/phone:reveal": {
      "post": {
        "description": "The only public route that returns a real number.\n\nA POST rather than a GET on purpose: this has a side effect \u2014 it writes an\n`entity.sensitive_read` audit row \u2014 and it must never be cached, pre-fetched, logged in a\nquery string or replayed from browser history the way a GET can be.\n\nGuarded by the dangerous `read_sensitive` permission and a second factor, then re-scoped\nto this one contact. Filtering a list and forgetting the detail route is the named\nvulnerability this shape exists to avoid.",
        "operationId": "reveal_contact_phone_api_v1_contacts__contact_id__phone_reveal_post",
        "parameters": [
          {
            "in": "path",
            "name": "contact_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Contact Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactPhoneRevealed"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reveal a contact's real phone number (audited)",
        "tags": [
          "customer"
        ]
      }
    },
    "/api/v1/customer/info": {
      "get": {
        "operationId": "info_api_v1_customer_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this service is",
        "tags": [
          "customer"
        ]
      }
    },
