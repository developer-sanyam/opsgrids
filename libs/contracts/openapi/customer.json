    "/api/v1/customers/owners": {
      "get": {
        "description": "A plain array, not a page: the SPA loads the whole directory once and resolves\n`owner_id` values client-side. Reference data within the organization, so it is\norg-scoped but not scope-narrowed \u2014 a name must resolve on any row a caller sees.",
        "operationId": "list_owners_api_v1_customers_owners_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OwnerOut"
                  },
                  "title": "Response List Owners Api V1 Customers Owners Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The rep directory \u2014 who owner_id values resolve to",
        "tags": [
          "customer"
        ]
      }
