          "annual_revenue_minor": {
            "title": "Annual Revenue Minor",
            "type": "integer"
          },
          "city": {
            "title": "City",
            "type": "string"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "industry": {
            "title": "Industry",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "size_band": {
            "title": "Size Band",
            "type": "string"
          },
          "status": {
            "enum": [
              "customer",
              "prospect",
              "lead",
              "churned"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "domain",
          "industry",
          "size_band",
          "city",
          "country",
          "status",
          "owner_id",
          "annual_revenue_minor",
          "currency",
          "created_at"
        ],
        "title": "CompanyOut",
        "type": "object"
      },
      "ContactOut": {
        "description": "Mirrors the SPA's `Contact`. `phone` is the masked read shape the service returns by\ndefault; `last_activity_at` is NULL for a contact never touched.",
        "properties": {
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_activity_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Activity At"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "status": {
            "enum": [
              "customer",
              "qualified",
              "lead",
              "dormant"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "full_name",
          "title",
          "email",
          "phone",
          "company_id",
          "status",
          "owner_id",
          "last_activity_at",
