{
  "components": {
    "schemas": {
      "CompanyIn": {
        "additionalProperties": false,
        "description": "Open an account in the book.\n\n`annual_revenue_minor` is integer minor units of `currency` (ISO-4217) \u2014 a float is\nrefused rather than rounded, because rounding money silently is the bug the integer rule\nexists to prevent. `created_at` and the row's id are the service's to set, not the\nclient's, and `organization_id` comes from the tenant context.",
        "properties": {
          "annual_revenue_minor": {
            "default": 0,
            "minimum": 0.0,
            "title": "Annual Revenue Minor",
            "type": "integer"
          },
          "city": {
            "default": "",
            "maxLength": 120,
            "title": "City",
            "type": "string"
          },
          "country": {
            "default": "",
            "maxLength": 120,
            "title": "Country",
            "type": "string"
          },
          "currency": {
            "default": "INR",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "domain": {
            "default": "",
            "maxLength": 120,
            "title": "Domain",
            "type": "string"
          },
          "industry": {
            "default": "",
            "maxLength": 80,
            "title": "Industry",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "size_band": {
            "default": "",
            "maxLength": 20,
            "title": "Size Band",
            "type": "string"
          },
          "status": {
            "default": "prospect",
            "enum": [
              "customer",
              "prospect",
              "lead",
              "churned"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "owner_id"
        ],
        "title": "CompanyIn",
        "type": "object"
      },
      "CompanyOut": {
        "description": "Mirrors the SPA's `Company`. `annual_revenue_minor` is minor units of `currency`;\n`size_band` is a display band (\"201-500\"), not a number.",
        "properties": {
          "annual_revenue_minor": {
            "title": "Annual Revenue Minor",
            "type": "integer"
          },
          "city": {
            "title": "City",
            "type": "string"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "industry": {
            "title": "Industry",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "size_band": {
            "title": "Size Band",
            "type": "string"
          },
          "status": {
            "enum": [
              "customer",
              "prospect",
              "lead",
              "churned"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "domain",
          "industry",
          "size_band",
          "city",
          "country",
          "status",
          "owner_id",
          "annual_revenue_minor",
          "currency",
          "created_at"
        ],
        "title": "CompanyOut",
        "type": "object"
      },
      "ContactIn": {
        "additionalProperties": false,
        "description": "Add a person to an account.\n\nA number arrives as `raw_phone` or not at all. The service also accepts a pre-masked\n`phone` string \u2014 that is how the seeds pass the display forms they were written with \u2014\nbut the public surface deliberately does not offer it: a mask a client supplied is a\nredaction of nothing, unverifiable against a number the service never held, and it would\nleave `phone` disagreeing with the sealed column beside it. Given `raw_phone`, the service\nseals it and *derives* the mask, exactly as `PUT /contacts/{id}/phone` does.\n\n`last_activity_at` is not accepted either: it is maintained from the pipeline's activity\ntimeline (`touch_contact_activity`), so a client setting it would be writing over derived\nbookkeeping with a claim nothing backs.",
        "properties": {
          "company_id": {
            "format": "uuid",
            "title": "Company Id",
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "raw_phone": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 4,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Phone"
          },
          "status": {
            "default": "lead",
            "enum": [
              "customer",
              "qualified",
              "lead",
              "dormant"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "default": "",
            "maxLength": 160,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "email",
          "company_id",
          "owner_id"
        ],
        "title": "ContactIn",
        "type": "object"
      },
      "ContactOut": {
        "description": "Mirrors the SPA's `Contact`. `phone` is the masked read shape the service returns by\ndefault; `last_activity_at` is NULL for a contact never touched.",
        "properties": {
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_activity_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Activity At"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "status": {
            "enum": [
              "customer",
              "qualified",
              "lead",
              "dormant"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "full_name",
          "title",
          "email",
          "phone",
          "company_id",
          "status",
          "owner_id",
          "last_activity_at",
          "created_at"
        ],
        "title": "ContactOut",
        "type": "object"
      },
      "ContactPhoneIn": {
        "additionalProperties": false,
        "description": "Set a contact's real number. The mask is derived from it, never supplied.",
        "properties": {
          "raw_phone": {
            "maxLength": 40,
            "minLength": 4,
            "title": "Raw Phone",
            "type": "string"
          }
        },
        "required": [
          "raw_phone"
        ],
        "title": "ContactPhoneIn",
        "type": "object"
      },
      "ContactPhoneRevealed": {
        "description": "A contact's real number, revealed to a human who stepped up.\n\nReturned only by the dedicated unmask route, which requires the dangerous\n`read_sensitive` permission and a second factor, and which writes an audit row every time.\n`phone` is None when the contact has no sealed number.",
        "properties": {
          "contact_id": {
            "title": "Contact Id",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "required": [
          "contact_id",
          "phone"
        ],
        "title": "ContactPhoneRevealed",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OwnerIn": {
        "additionalProperties": false,
        "description": "Add a rep to the directory.\n\nThe row's id is generated by the service. The demo seed derives deterministic ids so\ndeal-service's rows cross-link, but that is a seeding affordance: a client choosing the\nprimary key of a row it is about to create is how one tenant's id collides with another's\nintent. `organization_id` is absent for the same family of reason \u2014 the tenant comes from\nthe caller's context, never from the payload.",
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "role": {
            "default": "",
            "maxLength": 120,
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "email"
        ],
        "title": "OwnerIn",
        "type": "object"
      },
      "OwnerOut": {
        "description": "Mirrors the SPA's `Owner`. The `id` is what every `owner_id` in the product carries,\nincluding deal-service's \u2014 the SPA resolves display names from this list client-side.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "full_name",
          "email",
          "role"
        ],
        "title": "OwnerOut",
        "type": "object"
      },
      "Page_CompanyOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CompanyOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size",
          "pages"
        ],
        "title": "Page[CompanyOut]",
        "type": "object"
      },
      "Page_ContactOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ContactOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size",
          "pages"
        ],
        "title": "Page[ContactOut]",
        "type": "object"
      },
      "ServiceInfo": {
        "properties": {
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "schema_name"
        ],
        "title": "ServiceInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
