      "SsoStartOut": {
        "description": "Where to send the browser to authenticate.\n\nJSON rather than a 302 because the caller is a single-page app: it needs to stash its own\nreturn location before leaving, and a redirect the fetch layer follows invisibly gives it\nnowhere to do that. `state` is echoed so the client can recognise its own callback; it is\nnot a credential \u2014 the value that matters is stored server-side against it, and it is\nsingle-use.",
        "properties": {
          "authorization_url": {
            "title": "Authorization Url",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
