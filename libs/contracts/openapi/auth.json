    "/api/v1/auth/sso/callback": {
      "get": {
        "description": "Where the identity provider sends the browser back.\n\nReturns exactly what `POST /auth/login` returns on success \u2014 the same `TokenOut`, the\nsame httpOnly refresh cookie, a token minted by the same `issue_for`. That is deliberate:\na client should not be able to tell how somebody signed in from the shape of what it got,\nbecause anything that branched on it would be a second code path to keep correct.\n\nThe redirect URI registered with the provider is this path, and it comes from\nconfiguration (`sso_redirect_uri`) rather than from anything in the request \u2014 a redirect\ntarget a caller can influence is how an authorization code ends up somewhere else.",
        "operationId": "sso_callback_api_v1_auth_sso_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "maxLength": 2048,
              "minLength": 1,
              "title": "Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "maxLength": 512,
              "minLength": 1,
              "title": "State",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Finish single sign-on",
        "tags": [
          "auth"
        ]
      }
    },
