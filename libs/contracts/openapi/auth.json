  "info": {
    "description": "Credentials, sessions and tokens. The only service in the platform that holds a private signing key \u2014 everything else verifies through JWKS.",
    "title": "Auth service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "description": "Every verifier in the platform fetches this.\n\nPublic by design: it contains only public halves, and a client that cannot reach it\ncannot verify anything at all.",
        "operationId": "jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "items": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "title": "Response Jwks  Well Known Jwks Json Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Public signing keys",
        "tags": [
          "discovery"
        ]
      }
    },
    "/api/v1/auth/info": {
      "get": {
        "operationId": "info_api_v1_auth_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this service is",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Exchange credentials for tokens, or for the next step.\n\nThree outcomes: signed in, needs a second factor, or needs to pick an organization.\nThe organization comes from an explicit slug, the host the gateway saw, or a single\nmembership \u2014 never inferred from the email domain.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/TokenOut"
                    },
                    {
                      "$ref": "#/components/schemas/MfaRequired"
                    },
                    {
                      "$ref": "#/components/schemas/OrgSelectionRequired"
                    }
                  ],
                  "title": "Response Login Api V1 Auth Login Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Idempotent: signing out twice is not an error, and neither is a stale cookie.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Who the caller is",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/mfa/enrol": {
      "post": {
        "operationId": "mfa_enrol_api_v1_auth_mfa_enrol_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaEnrolStart"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Start setting up an authenticator app",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/mfa/enrol/confirm": {
