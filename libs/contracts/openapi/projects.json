{
  "components": {
    "schemas": {
      "BoardColumn": {
        "description": "One column of the workflow board \u2014 a stage and its ordered cards.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "stage": {
            "enum": [
              "backlog",
              "in_progress",
              "review",
              "done"
            ],
            "title": "Stage",
            "type": "string"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskOut"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "stage",
          "label"
        ],
        "title": "BoardColumn",
        "type": "object"
      },
      "BoardOut": {
        "description": "The whole board, its four stages in flow order. The SPA can derive this from the task\nlist; exposing it once lets a reporting view share the same grouping.",
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/BoardColumn"
            },
            "title": "Columns",
            "type": "array"
          }
        },
        "required": [
          "columns"
        ],
        "title": "BoardOut",
        "type": "object"
      },
      "BurndownPoint": {
        "description": "A point on the release/sprint burndown. Mirrors the SPA's `BurndownPoint`.",
        "properties": {
          "actual": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual"
          },
          "ideal": {
            "title": "Ideal",
            "type": "integer"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "label",
          "ideal",
          "actual"
        ],
        "title": "BurndownPoint",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
