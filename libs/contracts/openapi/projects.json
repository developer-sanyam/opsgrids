        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthSlice": {
        "description": "One slice of the delivery-health breakdown. Mirrors the SPA's `HealthSlice`.",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "key": {
            "enum": [
              "on_track",
              "at_risk",
              "delayed"
