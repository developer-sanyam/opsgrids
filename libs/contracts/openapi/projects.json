      "Person": {
        "description": "A member of the delivery org \u2014 a project owner or a task assignee. Mirrors the SPA's\n`Person`; `id` is the member's stable `ref` (`p-01`).",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
