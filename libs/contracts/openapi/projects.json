        "required": [
          "key",
          "label",
          "count",
          "pct"
        ],
        "title": "HealthSlice",
        "type": "object"
      },
      "MilestoneIn": {
        "description": "Create a milestone on a project (named by its `code`).",
        "properties": {
          "due_date": {
            "format": "date",
            "title": "Due Date",
            "type": "string"
          },
          "owner_ref": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Ref"
          },
          "progress_pct": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress Pct",
            "type": "integer"
          },
          "project_code": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Project Code",
            "type": "string"
          },
          "status": {
            "default": "on_track",
            "enum": [
              "completed",
              "on_track",
              "due_soon",
              "at_risk",
              "slipping"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "project_code",
          "title",
          "due_date"
        ],
        "title": "MilestoneIn",
        "type": "object"
      },
      "MilestoneOut": {
        "description": "Mirrors the SPA's `MilestoneOut`. `project_id` is the owning project's opaque id;\n`project_code` / `project_name` are denormalised for the list view.",
        "properties": {
          "due_date": {
            "format": "date",
            "title": "Due Date",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "owner": {
