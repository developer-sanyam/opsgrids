          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "Person",
        "type": "object"
      },
      "ProjectIn": {
        "description": "Create a project. `owner_ref` names an existing member by their `ref` (`p-01`).",
        "properties": {
          "budget_minor": {
            "default": 0,
            "minimum": 0.0,
            "title": "Budget Minor",
            "type": "integer"
          },
          "client": {
            "default": "",
            "maxLength": 200,
            "title": "Client",
            "type": "string"
          },
          "code": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Code",
            "type": "string"
          },
          "currency": {
            "default": "INR",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "health": {
            "default": "on_track",
            "enum": [
              "on_track",
              "at_risk",
              "delayed"
            ],
            "title": "Health",
            "type": "string"
          },
          "name": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "open_tasks": {
            "default": 0,
            "minimum": 0.0,
            "title": "Open Tasks",
            "type": "integer"
          },
          "owner_ref": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Ref"
          },
          "phase": {
            "default": "discovery",
            "enum": [
              "discovery",
              "design",
              "build",
              "stabilize",
              "launch",
              "live"
            ],
            "title": "Phase",
            "type": "string"
          },
          "progress_pct": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress Pct",
            "type": "integer"
          },
          "spent_minor": {
            "default": 0,
            "minimum": 0.0,
            "title": "Spent Minor",
            "type": "integer"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 2000,
            "title": "Summary",
            "type": "string"
          },
          "target_date": {
            "format": "date",
            "title": "Target Date",
            "type": "string"
          },
          "team_size": {
            "default": 0,
