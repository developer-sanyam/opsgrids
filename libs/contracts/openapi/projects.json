          },
          "progress_pct": {
            "title": "Progress Pct",
            "type": "integer"
          },
          "project_code": {
            "title": "Project Code",
            "type": "string"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "project_name": {
            "title": "Project Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "on_track",
              "due_soon",
              "at_risk",
              "slipping"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "project_code",
          "project_name",
          "title",
          "owner",
          "due_date",
          "status",
          "progress_pct"
        ],
        "title": "MilestoneOut",
        "type": "object"
      },
      "OverviewOut": {
        "description": "The Overview dashboard's server-side rollup. The SPA derives these from the project and\nmilestone lists; this is the same arithmetic exposed once, so a reporting view can share it.\n\n`on_time_pct` is the share of milestones that are on time (completed, on track or due soon);\n`milestones_due` counts unfinished milestones due within the next fortnight;\n`utilization_pct` is a representative resource-utilization figure (no capacity service yet).",
        "properties": {
          "active_projects": {
            "title": "Active Projects",
            "type": "integer"
          },
          "avg_progress_pct": {
            "title": "Avg Progress Pct",
            "type": "integer"
          },
          "burndown_delta_release": {
            "title": "Burndown Delta Release",
            "type": "number"
          },
          "burndown_delta_sprint": {
            "title": "Burndown Delta Sprint",
            "type": "number"
          },
          "burndown_release": {
            "items": {
              "$ref": "#/components/schemas/BurndownPoint"
            },
            "title": "Burndown Release",
            "type": "array"
          },
          "burndown_sprint": {
            "items": {
              "$ref": "#/components/schemas/BurndownPoint"
            },
            "title": "Burndown Sprint",
            "type": "array"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "health_breakdown": {
            "items": {
              "$ref": "#/components/schemas/HealthSlice"
            },
            "title": "Health Breakdown",
            "type": "array"
          },
          "milestones_due": {
            "title": "Milestones Due",
            "type": "integer"
          },
          "on_time_pct": {
            "title": "On Time Pct",
            "type": "number"
          },
          "total_budget_minor": {
            "title": "Total Budget Minor",
            "type": "integer"
          },
          "total_spent_minor": {
            "title": "Total Spent Minor",
            "type": "integer"
          },
          "utilization_pct": {
            "title": "Utilization Pct",
            "type": "integer"
          }
        },
        "required": [
          "active_projects",
          "on_time_pct",
          "milestones_due",
          "utilization_pct",
          "avg_progress_pct",
          "total_budget_minor",
          "total_spent_minor",
          "currency",
          "health_breakdown",
          "burndown_sprint",
          "burndown_release",
          "burndown_delta_sprint",
          "burndown_delta_release"
        ],
        "title": "OverviewOut",
        "type": "object"
      },
