{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(make help)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make check)",
      "Bash(make typecheck*)",
      "Bash(make test*)",
      "Bash(make hygiene)",
      "Bash(make boundaries)",
      "Bash(make secrets)",
      "Bash(make openapi-check)",
      "Bash(make contracts-check)",
      "Bash(make migration-check*)",
      "Bash(make frontend-typecheck*)",
      "Bash(make frontend-lint*)",
      "Bash(make frontend-test*)",
      "Bash(make frontend-build*)",
      "Bash(uv run pytest *)",
      "Bash(uv run mypy *)",
      "Bash(uv run ruff *)",
      "Bash(pnpm -r typecheck*)",
      "Bash(pnpm -r lint*)",
      "Bash(pnpm -r test*)"
    ],
    "ask": [
      "Bash(make deploy*)",
      "Bash(make edge-*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(make migrate*)",
      "Bash(make reconcile-roles*)",
      "Bash(make secrets-baseline*)",
      "Bash(python tools/purge_*)",
      "Bash(uv run python tools/purge_*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.bak)",
      "Read(./.env.local)",
      "Read(./.env.prod*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./tools/dev-bootstrap/keys/**)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(./**/*.pem)",
      "Bash(cat .env)",
      "Bash(cat .env.bak)",
      "Bash(cat *.pem)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git reset --hard origin/main*)",
      "Bash(make infra-reset*)"
    ]
  }
}
