# The edge, ADR-0012 §2 and §5, ADR-0013 §4.
#
# One catch-all site for every store, plus one named site per platform application. Every
# hostname a buyer can type — `<slug>.stores.opsgrids.com`, `merchant.com`, `www.merchant.com` —
# is served by the catch-all, and the decision about whether a name may have a certificate is
# made by one HTTP call to the storefront service. `app.opsgrids.com` is the dashboard, the one
# page a customer signs up and signs in on; it shares everything but its document root.
#
# Two things to understand before editing:
#
#   1. There is no per-merchant configuration here, and there must never be. A merchant
#      connecting a domain writes one database row; nothing writes to this file and nothing
#      reloads Caddy. That is the whole reason the design uses on-demand TLS with an `ask`
#      endpoint rather than a certificate per name. A block per *platform application* is not
#      per-merchant configuration — it changes when an app ships, not when a customer does.
#   2. `ask` is the only control on issuance. Without it, anyone who points ten thousand
#      hostnames at this IP burns our ACME account against Let's Encrypt's failed-validation
#      limits. Caddy treats any non-2xx (and any timeout) as "no", so a broken authorizer
#      stops *new* issuance and leaves certificates already in storage serving. The platform
#      names below are listed in TLS_PLATFORM_HOSTS, or the authorizer refuses them too.
#
# Validate before deploying — `make edge-validate HOST=...` runs `caddy validate` against the
# pinned image on the box. A Caddyfile that fails to load is a total outage of every
# merchant's shop, and there is no staging environment to catch it.
{
	# The ACME account contact. Not a secret; it is what Let's Encrypt emails about expiry.
	email {$ACME_EMAIL}

	# The http:// block below writes its own redirect, so Caddy's automatic one for the
	# catch-all https:// site is switched off rather than left to overlap it.
	auto_https disable_redirects

	on_demand_tls {
		# GET {$TLS_ASK_URL}?domain=<name> — 2xx means Caddy may obtain a certificate for
		# that name. The endpoint answers from the same bypass reader, the same 300-second
		# Redis cache and the same published-store check the origin uses.
		ask {$TLS_ASK_URL}
	}

	# No `acme_ca`, no `issuer` and no DNS provider, deliberately. Caddy's defaults try Let's
	# Encrypt and fall back to ZeroSSL on their own — two certificate authorities for no
	# configuration and no cost — and naming one issuer here would throw that away. A DNS
	# challenge would need a provider credential; the platform holds none and that is a class
	# of secret we do not want to own. HTTP-01 on port 80 is the only challenge that matters,
	# and it is the one the merchant's DNS change has already enabled.
}

# What every HTTPS site on this box shares: on-demand issuance, compression, the health route,
# the internal route sealed off from the internet, and the same-origin API. A site imports this
# and adds only its document root.
(edge) {
	tls {
		on_demand
	}

	log {
		output stdout
		format json
	}

	encode zstd gzip

	handle /_edge/health {
		respond "ok" 200
	}

	# Defence in depth, and cheap. `internal/tls-authorize` is reached by Caddy on the compose
	# network; it has no reason to be reachable from the internet through the edge. The
	# gateway's catch-all would demand a bearer token anyway — this makes that a fact here
	# rather than a consequence of a route table someone may edit.
	handle /api/v1/storefront/internal/* {
		respond "Not found" 404
	}

	# Same-origin API. The browser on merchant.com — or on app.opsgrids.com — calls its own
	# host's /api/..., so no hostname adds a CORS surface and `cors_origins` never grows a row.
	# Caddy preserves the incoming Host header on reverse_proxy by default, and sets
	# X-Forwarded-Host, X-Forwarded-For and X-Forwarded-Proto on its own — which is what the
	# gateway's public branch needs, so nothing is added here.
	#
	# **X-Forwarded-For is load-bearing, and the reason nothing is added is that Caddy's default
	# is already the safe one.** app-gateway keys its anonymous rate limit on it (it believes the
	# header only from a peer inside TRUSTED_PROXY_CIDRS, compose.prod.yml — this container's
	# network — and reads it from the right). For a client that is not in `trusted_proxies`,
	# Caddy *replaces* whatever X-Forwarded-For the client sent with the address it accepted the
	# connection from, so the gateway sees exactly one entry that no client chose. Checked
	# against the pinned image (2.10.0): a request carrying `X-Forwarded-For: 6.6.6.6, 7.7.7.7`
	# reaches the upstream as the peer's address alone. Do not add `header_up X-Forwarded-For`
	# (Caddy's own adapter warns it is unnecessary, once per site), and **do not add a global
	# `trusted_proxies`** without changing this: that option makes Caddy append to a client's
	# header instead, and the gateway's rightmost-untrusted read would then need the same CIDRs.
	# tests/infra/test_gateway_trusted_proxies.py fails if `trusted_proxies` appears in this
	# file. If a CDN or load balancer is ever put in front of this Caddy, the address Caddy sees
	# becomes that proxy's — RUNBOOK.md, "rate limiting behind Caddy", says what to change.
	#
	# A deploy that recreates the gateway leaves a few seconds where the dial fails. Caddy
	# retries a failed *dial* — never a request the gateway received — so holding the request
	# for up to 20s turns that window into a slow answer instead of a 502, for POSTs too.
	#
	# The two provider webhooks are unauthenticated and their bodies are buffered whole by the
	# gateway, so Caddy refuses one over the size the route allows (413) before it is proxied at
	# all: the same numbers as `max_body_bytes` in routes.prod.json (Razorpay 256 KiB; Meta
	# documents up to 3 MB, so 3 MiB), which tests/infra/test_gateway_trusted_proxies.py holds
	# equal. The gateway enforces the same caps itself and is the authority; this is the second
	# fence, and it is checked against the pinned Caddy (`request_body` with a named matcher, 413
	# on a body over `max_size`, other paths untouched).
	#
	# There is deliberately **no `read_body` timeout** here or in the global options. It applies to
	# every request on the server and would break slow, legitimate document uploads on the
	# authenticated paths. The slow-body risk on unauthenticated requests is bounded in the gateway
	# instead: a read deadline and a cap on how many are in flight (RUNBOOK.md, "Rate limiting
	# behind Caddy").
	handle /api/* {
		@razorpay_webhook path /api/v1/webhooks/razorpay
		request_body @razorpay_webhook {
			max_size 256KiB
		}
		@whatsapp_webhook path /api/v1/webhooks/whatsapp
		request_body @whatsapp_webhook {
			max_size 3MiB
		}
		reverse_proxy app-gateway:8000 {
			lb_try_duration 20s
			lb_try_interval 250ms
		}
	}
}

# ---------------------------------------------------------------------------- uploaded merchant images
#
# Public bucket objects (ADR-0009) are served from EDGE_HOST alone — the one host
# PUBLIC_ASSET_BASE_URL names (.env.example) — and now from NOWHERE else. This used to live in
# the shared `(edge)` snippet every site above imports, which meant it was reachable on
# app.opsgrids.com, ops.opsgrids.com and every other platform hostname too.
#
# That mattered because MinIO honours `?response-content-type=` (and other `response-*`
# overrides) on an anonymous GetObject: an attacker who uploads an HTML/JS payload through the
# storefront console's own upload endpoint could fetch it back as
# `/opsgrids-public/<uuid>?response-content-type=text/html` and have it rendered as HTML — on a
# platform host where the `.opsgrids.com`-scoped refresh cookie is live. That is stored XSS with
# a direct path to account takeover, not a theoretical header-smuggling concern. Restricting the
# route to this one host removes every other platform host from the attack surface; the query
# strip and response headers below are the second and third layers, so this survives a future
# contributor adding the route back to the shared snippet without reading this comment.
#
# `minio-init`'s anonymous policy already grants nothing but `s3:GetObject` (no ListBucket) —
# this is defence in depth on top of that, not a replacement for it.
https://{$EDGE_HOST} {
	import edge

	@opsgrids_public {
		# Driven by S3_PUBLIC_BUCKET (passed into this container's own environment below,
		# compose.prod.yml), not hardcoded: the URL path a browser fetches always matches
		# whatever bucket `minio-init` actually created, and renaming the bucket in `.env` is a
		# one-value change here too rather than a second place to remember. `document`'s
		# `PUBLIC_ASSET_BASE_URL` must still end in the same bucket name — `.env.example` says
		# so — because nothing here rewrites the path before proxying to MinIO (§ below).
		path /{$S3_PUBLIC_BUCKET}/*
		method GET HEAD
	}
	handle @opsgrids_public {
		# `rewrite * {path}` on its own does NOT drop the query string — Caddy retains the
		# incoming query unless the rewrite target explicitly ends in a bare `?`. Without this,
		# `?response-content-type=text/html` (and any other `response-*` override MinIO
		# honours) rides straight through to MinIO and comes back with that content type.
		rewrite * {path}?

		# There is no session and no reason for one to travel to an anonymous GetObject; strip
		# it so an operator error upstream can never turn this into a credential leak.
		request_header -Authorization

		# Objects are content-addressed UUID keys that are written once and never overwritten
		# (ADR-0009 §3, §9), so the same URL always names the same bytes or nothing — caching
		# it for a day costs nothing on the common path. Trade-off, stated plainly: a
		# `?purge=true` takedown (ADR-0009 §8) does not invalidate a cache that already has the
		# object, so an immediate takedown's real latency is bounded by this TTL wherever a
		# browser or intermediate proxy already cached the response, not by the takedown call
		# itself. Accepted — the alternative is re-fetching every image on every buyer page
		# view for a bucket whose entire point is that its contents don't change.
		header Cache-Control "public, max-age=86400"
		# The response here is always bytes this platform decoded and re-encoded itself
		# (ADR-0009 §5) or nothing at all — never HTML, and nothing a browser should ever be
		# invited to sniff into something else. A CSP on an image response is unusual; it costs
		# nothing and is the layer that still holds if the query strip above is ever bypassed
		# by a MinIO override nobody has found yet.
		header Content-Security-Policy "default-src 'none'; sandbox"
		header X-Content-Type-Options "nosniff"
		# MinIO's own version banner is not this platform's to publish.
		header -Server

		reverse_proxy minio:9000
	}

	handle {
		respond "Not found" 404
	}

	handle_errors {
		respond "Not found" {err.status_code}
	}
}

# ---------------------------------------------------------------------------- port 80
#
# Caddy installs its own ACME HTTP-01 challenge handler ahead of these routes, so defining
# this block does not stop issuance. Everything else on :80 is redirected, which is also what
# makes a merchant's first plain-HTTP visit work.
http:// {
	# The container healthcheck, and the first thing to curl when something is wrong: it
	# answers on plain HTTP with no certificate, no DNS and no upstream involved. If this
	# answers and a merchant domain does not, the problem is TLS or DNS, not the process.
	handle /_edge/health {
		respond "ok" 200
	}

	# Inside a `handle`, deliberately. Caddy evaluates directives in its own fixed order, not
	# the order they are written, and a bare `redir` sorts *before* every `handle` — so written
	# bare, it redirected `/_edge/health` too, the container healthcheck followed the 308 into
	# a TLS handshake, and Caddy reported itself unhealthy while serving perfectly. Found on
	# the first deploy. `handle` blocks are mutually exclusive and tried in written order.
	handle {
		redir https://{host}{uri} 308
	}
}

# ---------------------------------------------------------------------------- the dashboard
#
# A named site wins over the catch-all for its own host. The bundle is published by
# `make edge-web APP=dashboard` to `${EDGE_WEB_ROOT}/dashboard/current`.
https://app.opsgrids.com {
	import edge

	handle {
		root * /srv/web/dashboard/current
		try_files {path} /index.html
		file_server

		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	handle_errors {
		respond "The OpsGrids dashboard is not published on this box yet." {err.status_code}
	}
}

