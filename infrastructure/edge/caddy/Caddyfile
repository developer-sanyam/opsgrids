# ---------------------------------------------------------------------------- OpsGrids Engage
# Published by `make edge-web APP=engage`. Same shape as Inventory above. Its name is in the box's
# TLS_PLATFORM_HOSTS, which is what lets preflight pass and storefront's tls-authorize admit it.
# CSP: Meta's JavaScript SDK for WhatsApp Embedded Signup (connect.facebook.net, which talks to
# graph/www.facebook.com and frames www/web/staticxx.facebook.com). The sandboxed srcdoc email
# and campaign previews inherit this policy on top of their own meta CSP, so their inline styles
# and their opt-in remote images (`img-src https:`) must be allowed here as well.
https://engage.opsgrids.com {
	import edge
	import platform-headers "default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https:; connect-src 'self' https://app.opsgrids.com https://graph.facebook.com https://www.facebook.com; frame-src https://www.facebook.com https://web.facebook.com https://staticxx.facebook.com"

	handle {
		root * /srv/web/engage/current
		try_files {path} /index.html
		file_server

		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	handle_errors {
		respond "OpsGrids Engage is not published on this box yet." {err.status_code}
	}
}

# ---------------------------------------------------------------------------- every store
#
# A catch-all rather than a list of hostnames. `*.stores.opsgrids.com` is deliberately *not* a
# site address: a wildcard site address makes Caddy want a wildcard certificate, which needs a
# DNS challenge, which needs a provider credential we do not have. On-demand issues per name
# over HTTP-01 instead, and the per-name certificate is the honest thing anyway.
https:// {
	import edge

	# Not `platform-headers`: HSTS on a domain we do not own outlives our tenancy of it, and a
	# merchant may embed their own store, so no X-Frame-Options or frame-ancestors here. The CSP is
	# what the buyer bundle loads: its own script and stylesheet (no web fonts, no third-party
	# script), same-origin /api, merchant images from any https host (pasted addresses, uploads on
	# EDGE_HOST, catalogue pictures), and the video section's https embed, framed only on a press.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self'; frame-src https:; form-action 'self'; object-src 'none'; base-uri 'self'"
	}

	# The buyer bundle. One build, byte-identical for every merchant: it learns its store from
	# window.location.hostname and one bootstrap call, never from a baked-in config.
	handle {
		root * /srv/web/current
		try_files {path} /index.html
		file_server

		# Fingerprinted assets are immutable; the document is not, or a deploy would take a
		# cache TTL to reach anyone.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	# When the web root holds no bundle at all, `try_files` cannot find index.html and the
	# file server answers 404. Say so in a way that cannot be mistaken for a merchant's store.
	handle_errors {
		respond "This address is not serving a store right now. If you are the merchant, check your domain settings; if you are a shopper, try again shortly." {err.status_code}
	}
}
