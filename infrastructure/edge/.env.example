# The edge VM's environment. Copy to `infrastructure/edge/.env` ON THE BOX and fill it in.
#
#   * This file is committed and carries no values for anything secret. The real file lives
#     only on the VM, is gitignored, and is never printed into a log, a CI job or a ticket.
#   * `preflight.sh` reads the key names from THIS file and refuses to deploy when the box's
#     `.env` is missing one, leaves it empty, or still carries a `replace-me` placeholder. So
#     adding a key here is what makes it required — do that first, deploy second.
#   * Values marked GENERATE FRESH must be generated on the box and must never be copied from
#     development, from another environment, or from a chat window. Reusing a development
#     value in production is the failure this file exists to prevent, and `platform_core`
#     independently refuses to start with a `dev-only-` or `ci-only-` value in production.
#
# Generate every secret below with:  openssl rand -hex 32

# --- identity of this box -----------------------------------------------------
# What this box is. `make deploy CONFIRM=...` must match it exactly, so a deploy aimed at the
# wrong host fails before it changes anything instead of quietly succeeding.
EDGE_HOST=edge.opsgrids.com
# The reserved (floating) IPv4 attached to this VM, if the provider offers one. Part of the
# platform's public contract once set: apex merchants put it in their zone file, and it is the
# value the merchant UI prints. Optional — `storefront`'s `Settings.edge_reserved_ip` defaults
# to empty and the routing probe prints "the platform address" instead of a literal until this
# is filled in, which is the honest thing to show rather than a made-up example. Leave it empty
# on a box with no floating IP yet; fill it in with the box's real address before the first
# merchant apex record is created. Never a documentation-range address (192.0.2.0/24,
# 198.51.100.0/24, 203.0.113.0/24, RFC 5737) — `preflight.sh` warns if it is.
EDGE_RESERVED_IP=
# Where the buyer bundle releases live on the host. `make edge-web` writes
# $EDGE_WEB_ROOT/releases/<utc-timestamp>/ and swaps $EDGE_WEB_ROOT/current.
EDGE_WEB_ROOT=/srv/opsgrids/web

# --- TLS ----------------------------------------------------------------------
# The ACME account contact. Not a secret. Let's Encrypt emails this address about expiry, and
# in slice 1 that email is the ONLY way a human finds out a renewal has been failing — nothing
# is paged. Use a real, monitored inbox, not an alias nobody reads.
ACME_EMAIL=ops@example.com
# The platform's own hostnames this box may hold a certificate for, comma-separated and exact.
# Every certificate is issued on demand and gated by the storefront's tls-authorize endpoint;
# a store answers for its own names, but EDGE_HOST and any API name are nobody's store and
# are refused unless listed here. A name that is not here and not a published store gets no
# certificate — which is the safe direction to be wrong in.
TLS_PLATFORM_HOSTS=edge.opsgrids.com,api.opsgrids.com,app.opsgrids.com,ops.opsgrids.com,people.opsgrids.com,revenue.opsgrids.com,pulse.opsgrids.com,projects.opsgrids.com,support.opsgrids.com,marketing.opsgrids.com,finance.opsgrids.com,it.opsgrids.com,store.opsgrids.com,engage.opsgrids.com

# --- database -----------------------------------------------------------------
# GENERATE FRESH. The Postgres superuser (`opsgrids`). Used by backups and by psql sessions in
# the runbook; no service connects with it.
POSTGRES_PASSWORD=
# GENERATE FRESH. Shared by every `opsgrids_*` role — the per-service application roles, the
# admin role migrations run as, the BYPASSRLS readers. One password, many usernames, because
# each service rewrites only the username of DATABASE_URL onto its own role. Use hex or
# alphanumerics only: this value is substituted into a URL, and `@` or `/` will break it.
OPSGRIDS_DB_PASSWORD=

# --- auth ---------------------------------------------------------------------
# GENERATE FRESH, at least 32 bytes. Signs the internal service tokens every hop presents.
# A development value here is refused at startup, by design.
INTERNAL_SERVICE_TOKEN=
# GENERATE FRESH, at least 32 bytes, DIFFERENT from INTERNAL_SERVICE_TOKEN above. Signs the
# admin-gateway -> auth hop header on every operator request admin-gateway proxies (BLOCKER 2
# of the 2026-09-24 security review) — defence in depth on top of the route table already
# refusing /api/v1/auth/operator at every gateway. Only admin-gateway and auth read it.
ADMIN_GATEWAY_HOP_KEY=
# GENERATE FRESH, at least 32 bytes. The passphrase every tenant's PII is sealed under.
# Losing it means losing the ability to read encrypted PII: back it up somewhere that is not
# this box, before there is any data. Rotating it means putting the old value in
# PII_DECRYPT_KEYS (comma-separated) and the new one here.
PII_ENCRYPTION_KEY=
PII_DECRYPT_KEYS=
# The Ed25519 private key file on the HOST, mounted read-only into auth-service. Generate on
# the box with `openssl genpkey -algorithm ed25519 -out <path>`; never reuse the development
# key from `make devkeys`. Only auth-service holds it; everything else verifies via JWKS.
JWT_PRIVATE_KEY_HOST_PATH=/srv/opsgrids/secrets/jwt-ed25519.pem
# The `kid` published in JWKS and stamped on every token. Bump it when the key is rotated.
JWT_KID=prod-1
# Must match what every service expects; changing it invalidates every live token.
JWT_ISSUER=https://auth.opsgrids.com

# --- broker -------------------------------------------------------------------
# GENERATE FRESH. RabbitMQ's application user. Every relay publishes and every consumer reads
# with it; it never leaves the compose network.
RABBITMQ_PASSWORD=

# --- products this box sells (ADR-0013 §5) ------------------------------------
# Comma-separated compose profiles, one per sellable product: `inventory` (the operations
# service), `storefront`, and one named after each other product's catalogue key. Read by
# docker compose itself, and always explicit — write down every profile this box sells by hand
# (M4/review round 2: nothing computes this list for you any more; see below for why). Preflight
# refuses to deploy when the catalogue marks a product `available` whose profile is not listed
# here (a 504 waiting to happen), refuses outright when a product with a real activation has no
# profile running (a paying customer losing their product), and warns — never refuses — when a
# profile here has zero activations and is not even sold in the catalogue: safe to consider
# trimming, never forced.
#
# Left EMPTY here on purpose (the example used to turn every profile on at once — do not copy
# that back in: memory-budget.json's re-measured numbers show that combination no longer fits
# this box's hard budget line at all, let alone with margin for what is still on the backlog —
# see ADR-0013's memory-headroom addendum). Empty means core only, exactly and only that — an
# earlier version of this file computed a default from the catalogue's own activations when both
# this and EDGE_PROFILES were empty; that was removed (H2, review round 2) because `docker
# compose up` does not stop a container whose profile was silently removed, so the computed value
# never actually changed what ran, only what preflight/remote.sh *believed* was running. A human
# writes this list; nothing infers it any more.
COMPOSE_PROFILES=

# Optional (may be absent from an existing box's .env entirely, not just empty). An explicit,
# authoritative override for which product profiles run — set this instead of COMPOSE_PROFILES
# when a profile must run ahead of its first activation (onboarding a product, a demo). Always
# wins over COMPOSE_PROFILES in both preflight.sh and remote.sh. Same comma-separated profile
# names as COMPOSE_PROFILES above. (`COMPOSE_PROFILES=*` — every profile — is valid for docker
# compose and preflight expands it, but a hand-written list is what this file asks for.)
EDGE_PROFILES=

# Optional (may be absent). The memory-headroom slice's own owner decision (B2, review round 2):
# production runs every product it sells, and the measured cost of that already exceeds this
# box's hard budget line before a single planned service is added (see ADR-0013's memory-headroom
# addendum for the numbers). Preflight refuses a deploy over the hard line UNLESS this is set and
# the deploy's own total is at or under it. **The value is a decision record: exactly the
# post-deploy total preflight printed for the commit being deployed**, written down only after
# reading it, as the record that the owner looked at the overcommit and chose to run at it anyway
# rather than resize the box or de-list a product. A number larger than that total is slack
# nobody decided on (preflight says so); above `host.max_accepted_percent` of MemTotal (125% in
# memory-budget.json) it is a typo and FAILS the deploy, and no ceiling covers a total above it.
# Never set this to make a refuse go away without reading why it refused first; clear it once the
# box has been resized or a product de-listed (preflight says when it is set but not needed).
EDGE_BUDGET_ACCEPTED_MB=

# Optional, and deliberately COMMENTED OUT (an uncommented key here becomes required on every
# box). How many containers `docker compose up` starts at once during a deploy; four if unset.
# The deploy that merges a batch of new containers onto a box that is already swapping should
# set it to 2 for that one deploy (RUNBOOK.md, 'the memory budget'), then remove the line.
# EDGE_UP_PARALLEL_LIMIT=2

# Optional, COMMENTED OUT for the same reason. The operations reconcile sweep, storefront's
# custom-domain sweep and document's purge sweep run inside their own API containers, and
# compose.prod.yml defaults this to `true`. Any other value STOPS all three — the `*-cron`
# containers that used to carry them no longer exist — and preflight warns when it is not `true`.
# RUN_SWEEPS_IN_API=true

# --- email --------------------------------------------------------------------
# `log` renders and records every message and sends nothing; `smtp` sends. A signup cannot
# set a password and a trial cannot be warned until this is `smtp` with working credentials.
# The @opsgrids.com mailboxes are Google Workspace: the platform sends as one of them through
# Google's submission server (STARTTLS on 587). SMTP_PASSWORD is an app password for that
# mailbox (Google account → Security → 2-Step Verification → App passwords), never the
# mailbox's own password. Google's SPF/DKIM/DMARC records for the domain live at the registrar.
EMAIL_TRANSPORT=log
EMAIL_FROM=info@opsgrids.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=info@opsgrids.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
# ops-monitor only (notification-service ignores it): implicit TLS from the first byte
# ("SMTPS", conventionally port 465) instead of STARTTLS on the plain port — mutually
# exclusive with SMTP_USE_TLS above; ops-monitor's mailer refuses both at once. Google's
# submission server works with the STARTTLS default; this exists for a provider that only
# offers SMTPS.
SMTP_USE_SSL=false

# --- payments -----------------------------------------------------------------
# Razorpay. The key pair may stay empty: the payment service is then inert by design and
# nothing reaches the network. GENERATE FRESH the webhook secret regardless — production
# refuses the development default — and paste the same value into Razorpay's webhook settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- billing run tax (ADR-0005 addendum, 2026-09-23) --------------------------
# Which billing.tax_rates row the billing run applies to every invoice, e.g. gst / IN. Leave
# both empty until the deployment is registered for tax and a rate row exists: empty means no
# tax line. Set without a rate in force, the run refuses to invoice (and /health/billing-run's
# `failing` rises) rather than issuing an untaxed invoice.
BILLING_TAX_CODE=
BILLING_TAX_JURISDICTION=

# The billing run itself (trial conversion, renewals, prorations, closing usage) is OFF unless
# this says `true`. Read `python -m app.billing_run --dry-run` first (the runbook's "The billing
# run"), then uncomment it. Left unset, preflight warns and the run stays off.
# BILLING_RUN_ENABLED=true
# Required with it: the cutover, the moment billing goes live. No recurring charge for a period
# that began before it is ever invoiced (existing subscriptions start paying at their first period
# after it; a trial that ended before it converts free) and no usage from before it is billed.
# Set it once, to the moment you turn the run on, and never move it later. Syntax, exactly:
# YYYY-MM-DDTHH:MM:SS+HH:MM (or -HH:MM, or Z) - e.g. 2026-10-01T09:00:00+05:30 or
# 2026-10-01T03:30:00Z. Nothing else: no space for the T, no bare date, no naive time, no number.
# Run ./preflight.sh after setting it and before recreating subscription-worker.
# BILLING_RUN_NOT_BEFORE=2026-10-01T09:00:00+05:30

# --- WhatsApp (notification's channel; ADR-0013 §2 makes it an add-on) ----------
# All optional until a Meta app exists. `log` sends nothing.
WHATSAPP_TRANSPORT=log
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Engage (notification's campaign product) ----------------------------------
# Signs the unsubscribe link in every campaign mail (HMAC-SHA256). GENERATE FRESH — production
# refuses the `dev-only-` default, the same as every other signing secret here — and rotating it
# invalidates every unsubscribe link already sent. `python -c "import secrets;
# print(secrets.token_urlsafe(32))"` is as good a way to make one as any other.
ENGAGE_UNSUBSCRIBE_SECRET=
# Where `/engage/unsubscribe/{token}` is actually reachable from the outside. The send gate
# (services/notification/app/services.py's `_check_public_base`) refuses to send a campaign
# outside local/test/ci while this is still `localhost`/`127.0.0.1` or plain `http://` — a
# campaign whose unsubscribe link nobody's mailbox can open is not sendable at all.
ENGAGE_PUBLIC_API_BASE=https://app.opsgrids.com/api/v1

# --- database pool ------------------------------------------------------------
# Per process. ~50 processes share one Postgres started with max_connections=400.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# --- platform -----------------------------------------------------------------
# Where the merchant-facing application lives. Used in emails and links. Slice 1 does not
# deploy any merchant SPA to this box — see the runbook's "known gaps".
APP_BASE_URL=https://app.opsgrids.com
# Comma-separated. Custom domains add NOTHING to this list and must never be added to it: the
# buyer surface is same-origin through Caddy precisely so this stays a fixed set.
CORS_ORIGINS=https://app.opsgrids.com
LOG_LEVEL=INFO
# How long a resolved store slug or host is cached in Redis. Also the window during which a
# removed domain may still serve and a newly verified one may still be refused a certificate.
STORE_SLUG_CACHE_SECONDS=300

# --- backups ------------------------------------------------------------------
# Off-box object storage for `backup.sh`. A backup on this box's disk is not a backup.
# Any S3-compatible endpoint: the provider's object store, Backblaze B2, Cloudflare R2.
BACKUP_S3_BUCKET=opsgrids-backups
BACKUP_S3_PREFIX=edge/postgres
# Leave empty for AWS itself; set it for any other S3-compatible provider.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
# GENERATE FRESH, scoped to write-only access on the backup bucket and nothing else. A
# credential that can also delete is a credential ransomware can use.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# How many nightly dumps to keep on the box before the oldest is removed. The off-box copies
# are kept by the bucket's own lifecycle policy, which is set in the provider's console.
BACKUP_LOCAL_KEEP=7

# --- object storage: document-service's public asset store (ADR-0009) ---------
# Backs the storefront console's image upload (`/api/v1/documents/assets`) and is exercised
# only when the `storefront` profile is enabled below — document and MinIO both sit behind it
# (compose.prod.yml). Generate real values regardless: preflight's "every key in .env.example
# must be set" rule does not special-case a profile that happens to be off, and a box that never
# sells storefront just never starts the two containers that would read these.
#
# GENERATE FRESH. MinIO's root credential. `minio-init` (compose.prod.yml) uses it once, at
# startup, to create the opsgrids-public bucket and its anonymous-read policy, and to create the
# scoped `document` user below. Nothing else ever authenticates as root. MinIO requires at least
# 8 characters for the password.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# GENERATE FRESH. The scoped credential `document` actually connects with — `minio-init` creates
# this user and attaches a policy granting only `s3:PutObject` and `s3:DeleteObject` on
# `S3_PUBLIC_BUCKET`'s objects (`document` never calls GetObject or ListBucket; see
# `services/document/app/storage.py`). A compromised or merely buggy `document` process can put
# and delete objects in this one bucket and nothing more — it cannot list the bucket, touch a
# second bucket, or rewrite this bucket's own anonymous-read policy, which the MinIO root
# credential would have handed it for free. MinIO requires at least 8 characters for the secret.
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
# GENERATE FRESH. The orphan pass's own credential (ADR-0009 §9 addendum), held by no always-on
# container — only handed, by hand, to a one-off `docker compose run --rm --no-deps document
# ./bin/cron` (the purge sweep itself runs inside the `document` API without it, since the
# memory-headroom slice's fix round 2). `minio-init` creates this user and attaches a policy granting
# it `s3:ListBucket` on the bucket plus `s3:DeleteObject` on its objects, so the orphan pass
# can list what is actually in the bucket and remove what has no row. `document`'s own API
# container never receives these two values and never calls `ListBucket`
# (`services/document/app/storage.py`'s `ObjectStore` vs. `OrphanScanner`) — a compromised or
# merely buggy API process still cannot enumerate the bucket, which is the whole of ADR-0009
# §3's tenancy argument. Same 8-character minimum as the pair above.
DOCUMENT_S3_ORPHAN_ACCESS_KEY=
DOCUMENT_S3_ORPHAN_SECRET_KEY=
# Not a secret. How long a soft-deleted asset's object survives before the sweep removes it
# from the bucket (ADR-0009 §8). The committed default matches the ADR; raise or lower it here
# without touching code.
ASSET_PURGE_RETENTION_DAYS=30
# Not a secret. Off, and reporting-only even once on (ADR-0009 §9 addendum) — an automated,
# bucket-wide delete earns that much caution. (These two flags only take effect in a by-hand
# `docker compose run --rm --no-deps document ./bin/cron`: the document API never runs the
# orphan pass, whatever they say.) Turn DOCUMENT_ORPHAN_SWEEP_ENABLED on only once
# DOCUMENT_S3_ORPHAN_ACCESS_KEY/_SECRET_KEY above are set; leave DOCUMENT_ORPHAN_SWEEP_DRY_RUN
# at true until a run or two of its logged "would delete" candidates looks right, then flip it
# to false to let the sweep actually call DeleteObject.
DOCUMENT_ORPHAN_SWEEP_ENABLED=false
DOCUMENT_ORPHAN_SWEEP_DRY_RUN=true
# Not a secret. Public-read in its entirety (ADR-0009 §2) — nothing that is not meant to be
# world-readable is ever written here. Created by `minio-init` on first deploy. Caddy's
# `/opsgrids-public/*` proxy matcher is driven by this same variable (`caddy/Caddyfile`), so
# renaming it here is a one-value change and not a second hardcoded path to remember — just
# redeploy after changing it, and rename it in `PUBLIC_ASSET_BASE_URL` below in the same edit.
S3_PUBLIC_BUCKET=opsgrids-public
# Not a secret. What a stored `/a/{organization_id}/{asset_id}` reference resolves against
# (ADR-0009 §6): document returns it for the editor's own immediate preview, and it is what the
# storefront bundle's `VITE_ASSET_BASE_URL` must be built with so a buyer's browser resolves the
# same address. Caddy reverse-proxies `/opsgrids-public/*` straight to MinIO, but ONLY on
# EDGE_HOST's own site block (`caddy/Caddyfile`) — not on every host it serves, precisely so a
# malicious object cannot be served back as HTML on a platform hostname carrying the
# `.opsgrids.com`-scoped refresh cookie (MinIO honours `?response-content-type=` on an
# anonymous GetObject). So this must be `https://<EDGE_HOST>/opsgrids-public`, exact — the
# committed default matches this box's own EDGE_HOST above; change both together if you rename
# the box, and never point it at a different host Caddy serves, even one in TLS_PLATFORM_HOSTS.
PUBLIC_ASSET_BASE_URL=https://edge.opsgrids.com/opsgrids-public

# --- observability ------------------------------------------------------------
# Optional. This platform ships no error tracking of its own; if a Sentry project exists,
# putting its DSN here is the cheapest thing that turns an unnoticed 500 into a notification.
# Leave it empty and the services simply do not report.
SENTRY_DSN=

# --- ops-monitor (C10, R7, R37) -------------------------------------------------
# The box's own alerting — outbox lag, DLQ depth, API readiness, disk, backup freshness and
# certificate expiry, checked every 60s (RUNBOOK.md, "alerts and what each means"). Delivers by
# direct SMTP, reusing EMAIL_FROM and SMTP_* above (the box's own mailbox) — deliberately NOT
# through notification-service, which is one of the things being monitored. Leave OPS_ALERT_EMAIL
# empty and it still checks and still logs `ops.alert.firing` at error, it just pages nobody;
# preflight warns about this in capitals, the same as EMAIL_TRANSPORT=log above.
OPS_ALERT_EMAIL=
# Comma-separated `name[:port]`. Which API containers get a `/health/ready` check, checked
# concurrently. Empty (the normal case) means "derive from COMPOSE_PROFILES above" — the
# always-on core (auth, account, product, app-gateway, catalog, subscription, billing,
# metering, payment, notification) plus each enabled profile's own containers
# (`platform_core.ops_monitor.config.expected_api_containers` — read its docstring for the full
# per-profile list). Set this explicitly only to narrow the computed list or add a name it does
# not know about yet; doing so REPLACES the computed list entirely, it does not add to it. A
# name that does not resolve is a REAL failure now (round 2 of C10's review found that Docker's
# embedded DNS drops a stopped/crashed/OOM-killed/restarting container exactly the way it drops
# one that was never deployed — there is no way to tell those apart, so both alert).
OPS_MONITOR_API_CONTAINERS=
# Comma-separated. Which consumer queues get a `{queue}.dlq` depth check, checked concurrently.
# Empty (the normal case) means "derive from COMPOSE_PROFILES above" — the always-on core
# (account.events, product.events, subscription.events, payment.events, notification.events,
# notification.dispatch) plus each enabled profile's own worker queue
# (`platform_core.ops_monitor.config.expected_dlq_queues`). Same replace-not-append rule as
# OPS_MONITOR_API_CONTAINERS above if set explicitly.
OPS_MONITOR_DLQ_QUEUES=
